<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d">

    <!--
        ============================================================
        STANDARD BUTTON ANIMATION: All clickable buttons in this
        project should reuse the same animation style as the Trophies
        button in Overworld.xaml. Copy this pattern for any new button.

        Pattern (matches Trophies button in UI/Overworld.xaml):
          1. Wrap button in a Grid with RenderTransformOrigin="0.5,0.5"
             and ClipToBounds="False"
          2. Named ScaleTransform on Grid.RenderTransform
          3. Storyboard in Grid.Resources, RepeatBehavior="Forever":
             - ScaleX/ScaleY: 1.0 → 1.06, Duration 0:0:0.9,
               AutoReverse="True", SineEase EaseInOut
             - Gold glow Border Opacity: 0.0 → 1.0, same timing
          4. Auto-play via b:EventTrigger > b:ControlStoryboardAction
          5. Outer glow Border: Opacity="0", Background="Transparent",
             BorderBrush="#AAf5c518", BorderThickness="10",
             CornerRadius matching button, Margin="-8,-8,-8,-8"
          6. Main button Border underneath

        Art direction: Gold (#AAf5c518) glow, medieval fantasy theme.
        ============================================================
    -->

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#FFf5c518"/>
        <SolidColorBrush x:Key="ParchmentBrush" Color="#FFF5E6D0"/>
        <SolidColorBrush x:Key="DimGrey" Color="#FF666666"/>
    </Page.Resources>

    <Grid Visibility="{Binding visible, Converter={StaticResource BoolToVisConverter}}">

        <!-- Hazy gradient background: dark muted purple to warm reddish-brown -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FF2A1B3D" Offset="0"/>
                    <GradientStop Color="#FF3D2235" Offset="0.4"/>
                    <GradientStop Color="#FF4A2C2A" Offset="0.8"/>
                    <GradientStop Color="#FF3D2218" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Subtle haze overlay for depth -->
        <Rectangle Opacity="0.15">
            <Rectangle.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FF8866AA" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Viewbox Stretch="Uniform" Margin="20,20,20,20">
        <Grid Width="1080" Height="1920">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,40,0,20">
                <Grid HorizontalAlignment="Center">
                    <TextBlock Text="ACHIEVEMENTS" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="#22000000" Margin="-3,0,0,0"/>
                    <TextBlock Text="ACHIEVEMENTS" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="#22000000" Margin="3,0,0,0"/>
                    <TextBlock Text="ACHIEVEMENTS" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="#FFF5E6D0"/>
                </Grid>
            </StackPanel>

            <!-- Scrollable achievement gauge list -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly"
                          Margin="40,0,40,0">
                <ItemsControl ItemsSource="{Binding achievements}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Each achievement gauge row — layered medieval box -->
                            <Border Margin="0,8,0,8" Padding="0" CornerRadius="18"
                                    BorderThickness="3" BorderBrush="#CCc49a10">
                                <!-- Outer gold border with strong dark wood/stone fill -->
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#FF1A1008" Offset="0"/>
                                        <GradientStop Color="#FF2A1B10" Offset="0.3"/>
                                        <GradientStop Color="#FF33221A" Offset="0.7"/>
                                        <GradientStop Color="#FF1A1008" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- Inner bevel border — darker inset for depth -->
                                <Border CornerRadius="15" Margin="2"
                                        BorderThickness="2" BorderBrush="#44000000">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#33f5c518" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.3"/>
                                            <GradientStop Color="#00000000" Offset="0.7"/>
                                            <GradientStop Color="#22f5c518" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <!-- Inner content frame with subtle warm highlight on top edge -->
                                    <Border CornerRadius="16" BorderThickness="1,2,1,0" BorderBrush="#33F5E6D0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#44483020" Offset="0"/>
                                                <GradientStop Color="#22201008" Offset="0.15"/>
                                                <GradientStop Color="#11100804" Offset="0.85"/>
                                                <GradientStop Color="#33181008" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                <Grid>
                                    <!-- Tier-based background color overlay -->
                                    <Border CornerRadius="15" Background="{Binding tierBgColor}"/>
                                    <!-- Content with padding -->
                                    <Grid Margin="28,14,28,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: gauge content -->
                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Achievement name -->
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding name}" FontFamily="Anton"
                                                   FontSize="46" FontWeight="Bold"
                                                   Foreground="{Binding nameColor}"
                                                   Margin="0,0,0,2"/>

                                        <!-- Row 1: Description + progress text on same line -->
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding description}" FontFamily="Anton"
                                                       FontSize="30" Foreground="#AAF5E6D0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding progressText}" FontFamily="Anton"
                                                       FontSize="36" FontWeight="Bold"
                                                       Foreground="#FFF5E6D0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Row 2: Gauge bar -->
                                        <Grid Grid.Row="2" Height="28" Margin="0,2,0,0">
                                            <Border CornerRadius="14">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FF2A2018" Offset="0"/>
                                                        <GradientStop Color="#FF3D2E1A" Offset="0.5"/>
                                                        <GradientStop Color="#FF2A2018" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border CornerRadius="14" BorderThickness="2" BorderBrush="#33F5E6D0"/>
                                            <Border CornerRadius="14" HorizontalAlignment="Left"
                                                    Width="{Binding barWidth}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#DDf5c518" Offset="0"/>
                                                        <GradientStop Color="#CCc49a10" Offset="0.6"/>
                                                        <GradientStop Color="#BB8a6d0c" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- Right: Skull reward button — ANIMATED version (only when unclaimed rewards) -->
                                    <Grid Grid.Column="1" VerticalAlignment="Stretch" Margin="16,0,0,0"
                                          Visibility="{Binding skullAnimVisible, Converter={StaticResource BoolToVisConverter}}"
                                          RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                                        <Grid.RenderTransform><ScaleTransform x:Name="SkullBtnScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                                        <Grid.Resources>
                                            <Storyboard x:Key="SkullBtnPulseAnim" RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SkullBtnScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SkullBtnScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SkullBtnGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </Grid.Resources>
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger>
                                                <b:ControlStoryboardAction Storyboard="{StaticResource SkullBtnPulseAnim}"/>
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>

                                        <!-- Outer glow border (Trophies style) -->
                                        <Border x:Name="SkullBtnGlow" Opacity="0"
                                                Background="Transparent"
                                                BorderBrush="#AAf5c518"
                                                BorderThickness="10"
                                                CornerRadius="20"
                                                Margin="-8,-8,-8,-8"/>

                                        <!-- Main skull button -->
                                        <Button Command="{Binding Path=DataContext.events.skullTap, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding groupIndex}"
                                                Background="Transparent" BorderThickness="0"
                                                MinWidth="160">
                                            <Border CornerRadius="14" BorderThickness="3" BorderBrush="#CCc49a10" Padding="12,8,12,8" Width="140" Height="140">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="#FF1E1410" Offset="0"/>
                                                        <GradientStop Color="#FF2A1B12" Offset="0.4"/>
                                                        <GradientStop Color="#FF33221A" Offset="0.7"/>
                                                        <GradientStop Color="#FF1E1410" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid HorizontalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- Skull icon -->
                                                    <Viewbox Grid.Row="0" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid Width="24" Height="24">
                                                            <Path Fill="#E8E8E8" Data="M12 2 C7 2 3 6 3 11 C3 14 4 16 6 17 L6 20 C6 21 7 22 8 22 L16 22 C17 22 18 21 18 20 L18 17 C20 16 21 14 21 11 C21 6 17 2 12 2 Z"/>
                                                            <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                                            <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,2"/>
                                                            <Path Fill="#1A1A2E" Data="M11 14 L12 16 L13 14 Z"/>
                                                            <Path Fill="#1A1A2E" Data="M9 18 L9 20 M11 18 L11 20 M13 18 L13 20 M15 18 L15 20" StrokeThickness="0.8" Stroke="#1A1A2E"/>
                                                        </Grid>
                                                    </Viewbox>
                                                    <!-- Reward text -->
                                                    <TextBlock Grid.Row="1" Text="{Binding rewardButtonText}" FontFamily="Anton"
                                                               FontSize="28" FontWeight="Bold"
                                                               Foreground="{Binding rewardButtonColor}"
                                                               HorizontalAlignment="Center" Margin="0,6,0,0"
                                                               VerticalAlignment="Bottom"
                                                               TextWrapping="NoWrap" TextAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </Grid>

                                    <!-- Right: Skull reward button — STATIC version (no unclaimed rewards) -->
                                    <Grid Grid.Column="1" VerticalAlignment="Stretch" Margin="16,0,0,0"
                                          Visibility="{Binding skullStaticVisible, Converter={StaticResource BoolToVisConverter}}">
                                        <!-- Main skull button (no animation) -->
                                        <Button Command="{Binding Path=DataContext.events.skullTap, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding groupIndex}"
                                                Background="Transparent" BorderThickness="0"
                                                MinWidth="160">
                                            <Border CornerRadius="14" BorderThickness="3" BorderBrush="#CCc49a10" Padding="12,8,12,8" Width="140" Height="140">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="#FF1E1410" Offset="0"/>
                                                        <GradientStop Color="#FF2A1B12" Offset="0.4"/>
                                                        <GradientStop Color="#FF33221A" Offset="0.7"/>
                                                        <GradientStop Color="#FF1E1410" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid HorizontalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- Skull icon -->
                                                    <Viewbox Grid.Row="0" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Grid Width="24" Height="24">
                                                            <Path Fill="#E8E8E8" Data="M12 2 C7 2 3 6 3 11 C3 14 4 16 6 17 L6 20 C6 21 7 22 8 22 L16 22 C17 22 18 21 18 20 L18 17 C20 16 21 14 21 11 C21 6 17 2 12 2 Z"/>
                                                            <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                                            <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,2"/>
                                                            <Path Fill="#1A1A2E" Data="M11 14 L12 16 L13 14 Z"/>
                                                            <Path Fill="#1A1A2E" Data="M9 18 L9 20 M11 18 L11 20 M13 18 L13 20 M15 18 L15 20" StrokeThickness="0.8" Stroke="#1A1A2E"/>
                                                        </Grid>
                                                    </Viewbox>
                                                    <!-- Reward text -->
                                                    <TextBlock Grid.Row="1" Text="{Binding rewardButtonText}" FontFamily="Anton"
                                                               FontSize="28" FontWeight="Bold"
                                                               Foreground="{Binding rewardButtonColor}"
                                                               HorizontalAlignment="Center" Margin="0,6,0,0"
                                                               VerticalAlignment="Bottom"
                                                               TextWrapping="NoWrap" TextAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </Grid>
                                    </Grid>
                                </Grid>
                                    </Border>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Close button with Trophies-style pulsing animation -->
            <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,30"
                  RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                <Grid.RenderTransform><ScaleTransform x:Name="CloseBtnScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                <Grid.Resources>
                    <Storyboard x:Key="CloseBtnPulseAnim" RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="CloseBtnScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="CloseBtnScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="CloseBtnGlow"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Grid.Resources>
                <b:Interaction.Triggers>
                    <b:EventTrigger>
                        <b:ControlStoryboardAction Storyboard="{StaticResource CloseBtnPulseAnim}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>

                <!-- Outer glow border (Trophies style) -->
                <Border x:Name="CloseBtnGlow" Opacity="0"
                        Background="Transparent"
                        BorderBrush="#AAf5c518"
                        BorderThickness="10"
                        CornerRadius="36"
                        Margin="-8,-8,-8,-8"/>

                <!-- Main CLOSE button -->
                <Border Background="#CC1A1420" BorderBrush="{StaticResource ParchmentBrush}"
                        BorderThickness="3" CornerRadius="30" Padding="60,16,60,16">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonUp">
                            <b:InvokeCommandAction Command="{Binding events.closeTap}" CommandParameter="close"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <TextBlock Text="CLOSE" FontFamily="Anton" FontSize="52" FontWeight="Bold" Foreground="#FFF5E6D0" HorizontalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- ========== REWARD POPUP OVERLAY (Modal Card) ========== -->
            <Grid Grid.Row="0" Grid.RowSpan="3"
                  Visibility="{Binding rewardPopup.visible, Converter={StaticResource BoolToVisConverter}}">

                <!-- Semi-transparent dark backdrop so achievements are dimmed but visible -->
                <Rectangle Fill="#CC000000"/>

                <!-- Centered card panel (~75% width, auto height, vertically centered) -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      Width="810" MaxHeight="1600" Margin="0,60,0,60">

                    <!-- Card background: layered medieval box matching achievement rows -->
                    <Border CornerRadius="22" Padding="0"
                            BorderThickness="4" BorderBrush="#CCc49a10">
                        <!-- Outer thick gold/bronze border with dark wood/stone gradient -->
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#FF1A1008" Offset="0"/>
                                <GradientStop Color="#FF2A1B10" Offset="0.3"/>
                                <GradientStop Color="#FF33221A" Offset="0.7"/>
                                <GradientStop Color="#FF1A1008" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <!-- Inner bevel border with gold shimmer -->
                        <Border CornerRadius="18" Margin="3"
                                BorderThickness="2" BorderBrush="#44000000">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#33f5c518" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="0.3"/>
                                    <GradientStop Color="#00000000" Offset="0.7"/>
                                    <GradientStop Color="#22f5c518" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <!-- Inner content frame with parchment-lit top edge -->
                            <Border CornerRadius="16" BorderThickness="1,2,1,0" BorderBrush="#33F5E6D0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#44483020" Offset="0"/>
                                        <GradientStop Color="#22201008" Offset="0.15"/>
                                        <GradientStop Color="#11100804" Offset="0.85"/>
                                        <GradientStop Color="#33181008" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                        <Grid Margin="40,36,40,36">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header: Title -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding rewardPopup.groupName}" FontFamily="Anton" FontSize="64" FontWeight="Bold" Foreground="#FFF5E6D0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="REWARDS" FontFamily="Anton" FontSize="42" FontWeight="Bold" Foreground="#AAF5E6D0" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Tier list -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                <ItemsControl ItemsSource="{Binding rewardPopup.tiers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Layered medieval box matching main achievement rows -->
                                            <Border Margin="0,8,0,8" Padding="0" CornerRadius="18"
                                                    BorderThickness="3" BorderBrush="#CCc49a10"
                                                    Opacity="{Binding rowOpacity}">
                                                <!-- Outer gold border with dark wood/stone gradient fill -->
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="#FF1A1008" Offset="0"/>
                                                        <GradientStop Color="#FF2A1B10" Offset="0.3"/>
                                                        <GradientStop Color="#FF33221A" Offset="0.7"/>
                                                        <GradientStop Color="#FF1A1008" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <!-- Inner bevel border with gold shimmer -->
                                                <Border CornerRadius="15" Margin="2"
                                                        BorderThickness="2" BorderBrush="#44000000">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#33f5c518" Offset="0"/>
                                                            <GradientStop Color="#00000000" Offset="0.3"/>
                                                            <GradientStop Color="#00000000" Offset="0.7"/>
                                                            <GradientStop Color="#22f5c518" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <!-- Inner content frame with parchment-lit top edge -->
                                                    <Border CornerRadius="16" BorderThickness="1,2,1,0" BorderBrush="#33F5E6D0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                <GradientStop Color="#44483020" Offset="0"/>
                                                                <GradientStop Color="#22201008" Offset="0.15"/>
                                                                <GradientStop Color="#11100804" Offset="0.85"/>
                                                                <GradientStop Color="#33181008" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                <Grid>
                                                    <!-- Tier-based background color overlay -->
                                                    <Border CornerRadius="14" Background="{Binding tierBgColor}"/>
                                                    <!-- Content with padding -->
                                                    <Grid Margin="28,18,28,18">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Tier info -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding tierName}" FontFamily="Anton" FontSize="40" FontWeight="Bold" Foreground="{Binding textColor}"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Target: " FontFamily="Anton" FontSize="30" Foreground="#AAF5E6D0"/>
                                                            <TextBlock Text="{Binding tierTarget}" FontFamily="Anton" FontSize="30" Foreground="#AAF5E6D0"/>
                                                            <TextBlock Text="  |  " FontFamily="Anton" FontSize="30" Foreground="#55F5E6D0"/>
                                                            <TextBlock Text="Skulls: " FontFamily="Anton" FontSize="30" Foreground="#FFF5E6D0"/>
                                                            <TextBlock Text="{Binding skullReward}" FontFamily="Anton" FontSize="30" FontWeight="Bold" Foreground="{Binding textColor}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Claim button with Trophies-style animation (visible when claimable) -->
                                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                                          Visibility="{Binding claimVisible, Converter={StaticResource BoolToVisConverter}}"
                                                          RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                                                        <Grid.RenderTransform><ScaleTransform x:Name="ClaimBtnScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                                                        <Grid.Resources>
                                                            <Storyboard x:Key="ClaimBtnPulseAnim" RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="ClaimBtnScale"
                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                 From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="ClaimBtnScale"
                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                 From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="ClaimBtnGlow"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </Grid.Resources>
                                                        <b:Interaction.Triggers>
                                                            <b:EventTrigger>
                                                                <b:ControlStoryboardAction Storyboard="{StaticResource ClaimBtnPulseAnim}"/>
                                                            </b:EventTrigger>
                                                        </b:Interaction.Triggers>

                                                        <!-- Outer glow border (Trophies style) -->
                                                        <Border x:Name="ClaimBtnGlow" Opacity="0"
                                                                Background="Transparent"
                                                                BorderBrush="#AAf5c518"
                                                                BorderThickness="10"
                                                                CornerRadius="22"
                                                                Margin="-8,-8,-8,-8"/>

                                                        <!-- Main Claim button (bigger) -->
                                                        <Border Background="#CCf5c518" CornerRadius="18" Padding="32,16,32,16">
                                                            <b:Interaction.Triggers>
                                                                <b:EventTrigger EventName="MouseLeftButtonUp">
                                                                    <b:InvokeCommandAction Command="{Binding Path=DataContext.rewardPopup.events.claimTap, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                           CommandParameter="{Binding claimParam}"/>
                                                                </b:EventTrigger>
                                                            </b:Interaction.Triggers>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding claimButtonText}" FontFamily="Anton" FontSize="40" FontWeight="Bold" Foreground="#FF1A1420" VerticalAlignment="Center"/>
                                                                <Viewbox Width="48" Height="48" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <Grid Width="24" Height="24">
                                                                        <Path Fill="#FF1A1420" Data="M12 2 C7 2 3 6 3 11 C3 14 4 16 6 17 L6 20 C6 21 7 22 8 22 L16 22 C17 22 18 21 18 20 L18 17 C20 16 21 14 21 11 C21 6 17 2 12 2 Z"/>
                                                                        <Ellipse Width="4" Height="5" Fill="#CCf5c518" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                                                        <Ellipse Width="4" Height="5" Fill="#CCf5c518" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,2"/>
                                                                        <Path Fill="#CCf5c518" Data="M11 14 L12 16 L13 14 Z"/>
                                                                        <Path Fill="#CCf5c518" Data="M9 18 L9 20 M11 18 L11 20 M13 18 L13 20 M15 18 L15 20" StrokeThickness="0.8" Stroke="#CCf5c518"/>
                                                                    </Grid>
                                                                </Viewbox>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Claimed text (visible when already claimed) -->
                                                    <TextBlock Grid.Column="2" Text="Claimed" FontFamily="Anton" FontSize="32"
                                                               Foreground="#FF88AA88" VerticalAlignment="Center" Margin="12,0,0,0"
                                                               Visibility="{Binding claimedVisible, Converter={StaticResource BoolToVisConverter}}"/>
                                                    </Grid>
                                                </Grid>
                                                    </Border>
                                                </Border>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Back button with Trophies-style pulsing animation (smaller) -->
                            <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,8"
                                  RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                                <Grid.RenderTransform><ScaleTransform x:Name="BackBtnScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                                <Grid.Resources>
                                    <Storyboard x:Key="BackBtnPulseAnim" RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="BackBtnScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BackBtnScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BackBtnGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </Grid.Resources>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger>
                                        <b:ControlStoryboardAction Storyboard="{StaticResource BackBtnPulseAnim}"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>

                                <!-- Outer glow border (Trophies style) -->
                                <Border x:Name="BackBtnGlow" Opacity="0"
                                        Background="Transparent"
                                        BorderBrush="#AAf5c518"
                                        BorderThickness="10"
                                        CornerRadius="26"
                                        Margin="-8,-8,-8,-8"/>

                                <!-- Main BACK button (smaller) -->
                                <Border Background="#CC1A1420" BorderBrush="{StaticResource ParchmentBrush}"
                                        BorderThickness="3" CornerRadius="22" Padding="32,10,32,10">
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="MouseLeftButtonUp">
                                            <b:InvokeCommandAction Command="{Binding events.closeTap}" CommandParameter="close"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                    <TextBlock Text="BACK" FontFamily="Anton" FontSize="36" FontWeight="Bold" Foreground="#FFF5E6D0" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>
                            </Border>
                        </Border>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
        </Viewbox>
    </Grid>
</Page>
