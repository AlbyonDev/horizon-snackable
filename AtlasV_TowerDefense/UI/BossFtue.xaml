<Component xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:noesis="clr-namespace:NoesisGUIExtensions"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           mc:Ignorable="d"
           d:DesignWidth="1080" d:DesignHeight="1920">

  <noesis:LayoutScaler ReferenceResolution="1080,1920">
    <Grid>
      <!-- Full-screen dark overlay -->
      <Grid Background="#CC000000">
        <Grid.Visibility>
          <Binding Path="visible">
            <Binding.Converter>
              <BooleanToVisibilityConverter/>
            </Binding.Converter>
          </Binding>
        </Grid.Visibility>
      </Grid>

      <!-- Popup panel (centered) -->
      <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="60,0,60,0">
        <Grid.Visibility>
          <Binding Path="visible">
            <Binding.Converter>
              <BooleanToVisibilityConverter/>
            </Binding.Converter>
          </Binding>
        </Grid.Visibility>

        <Border Background="#EE1a1a2e"
                BorderBrush="#cc3333"
                BorderThickness="6"
                CornerRadius="24"
                Padding="40,28,40,28"
                MaxWidth="900">
          <StackPanel HorizontalAlignment="Center">
            <!-- Title with fiery red/gold outline -->
            <Grid HorizontalAlignment="Center" Margin="0,0,0,12">
              <TextBlock Text="⚠ BOSS LEVEL ⚠" FontFamily="Anton"
                         FontSize="60" FontWeight="Bold" Foreground="Black" Margin="-3,0,0,0"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="⚠ BOSS LEVEL ⚠" FontFamily="Anton"
                         FontSize="60" FontWeight="Bold" Foreground="Black" Margin="3,0,0,0"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="⚠ BOSS LEVEL ⚠" FontFamily="Anton"
                         FontSize="60" FontWeight="Bold" Foreground="Black" Margin="0,-3,0,0"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="⚠ BOSS LEVEL ⚠" FontFamily="Anton"
                         FontSize="60" FontWeight="Bold" Foreground="Black" Margin="0,3,0,0"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="⚠ BOSS LEVEL ⚠" FontFamily="Anton"
                         FontSize="60" FontWeight="Bold" Foreground="#f5c518"
                         HorizontalAlignment="Center"/>
            </Grid>

            <!-- Body text - line 1 -->
            <TextBlock Text="The boss throws projectiles from inside its cave... Will it come out?"
                       FontFamily="Almendra" FontSize="44"
                       Foreground="#dddddd"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,0,0,12"/>

            <!-- Body text - line 3 (warning) -->
            <TextBlock Text="If the boss reaches you, it kills you in one go!"
                       FontFamily="Almendra" FontSize="44"
                       Foreground="#ff4444"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,0,0,24"/>

            <!-- Got it! button with breathing pulse animation -->
            <Grid HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
              <Grid.RenderTransform>
                <ScaleTransform x:Name="BossGotItBtnScale" ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <Grid.Resources>
                <Storyboard x:Key="BossGotItPulseAnim" RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetName="BossGotItBtnScale"
                                   Storyboard.TargetProperty="ScaleX"
                                   From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="BossGotItBtnScale"
                                   Storyboard.TargetProperty="ScaleY"
                                   From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="BossGotItGlow"
                                   Storyboard.TargetProperty="Opacity"
                                   From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Key="BossGotItPressAnim">
                  <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BossGotItBtnScale" Storyboard.TargetProperty="ScaleX">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.90">
                      <EasingDoubleKeyFrame.EasingFunction><PowerEase EasingMode="EaseOut" Power="2"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0">
                      <EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                  </DoubleAnimationUsingKeyFrames>
                  <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BossGotItBtnScale" Storyboard.TargetProperty="ScaleY">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.90">
                      <EasingDoubleKeyFrame.EasingFunction><PowerEase EasingMode="EaseOut" Power="2"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0">
                      <EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                  </DoubleAnimationUsingKeyFrames>
                </Storyboard>
              </Grid.Resources>
              <b:Interaction.Triggers>
                <b:EventTrigger>
                  <b:ControlStoryboardAction Storyboard="{StaticResource BossGotItPulseAnim}"/>
                </b:EventTrigger>
                <b:EventTrigger EventName="MouseLeftButtonDown">
                  <b:ControlStoryboardAction Storyboard="{StaticResource BossGotItPressAnim}"/>
                </b:EventTrigger>
              </b:Interaction.Triggers>

              <!-- Outer glow border (pulsing red shimmer) -->
              <Border x:Name="BossGotItGlow" Opacity="0"
                      Background="Transparent"
                      BorderBrush="#AAcc3333"
                      BorderThickness="10"
                      CornerRadius="24"
                      Margin="-8,-8,-8,-8"
                      IsHitTestVisible="False"/>

              <Button Command="{Binding events.gotIt}"
                      HorizontalAlignment="Center"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      Margin="0,4,0,0">
                <Border Background="#cc3333"
                        CornerRadius="16"
                        Padding="52,14,52,14">
                  <TextBlock Text="Got it!" FontFamily="Anton"
                             FontSize="52" FontWeight="Bold"
                             Foreground="#1a1a2e"
                             HorizontalAlignment="Center"/>
                </Border>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

    </Grid>
  </noesis:LayoutScaler>
</Component>
