<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignWidth="1080" d:DesignHeight="1920">

    <Page.Resources>
        <!-- Colors matching TowerShop/GameOverScreen medieval fantasy style -->
        <SolidColorBrush x:Key="GoldBrush" Color="#f5c518"/>
        <SolidColorBrush x:Key="GoldDarkBrush" Color="#c9a000"/>
        <SolidColorBrush x:Key="WoodBrush" Color="#2a1a0e"/>
        <SolidColorBrush x:Key="RedBrush" Color="#e74c3c"/>
        <SolidColorBrush x:Key="CreamBrush" Color="#f5e6c8"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Page.Resources>
    <Page.Visibility>
        <Binding Path="visible">
            <Binding.Converter>
                <BooleanToVisibilityConverter/>
            </Binding.Converter>
        </Binding>
    </Page.Visibility>

    <Grid>
    <!-- Countdown overlay - centered on screen, shown only before wave 1 -->
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center"
          IsHitTestVisible="False"
          Visibility="{Binding showCountdown, Converter={StaticResource BoolToVisConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Label -->
        <Grid Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="WAVE INCOMING!" FontFamily="Anton" FontSize="90" FontWeight="Bold" Foreground="Black" Margin="-4,0,0,0"/>
            <TextBlock Text="WAVE INCOMING!" FontFamily="Anton" FontSize="90" FontWeight="Bold" Foreground="Black" Margin="4,0,0,0"/>
            <TextBlock Text="WAVE INCOMING!" FontFamily="Anton" FontSize="90" FontWeight="Bold" Foreground="Black" Margin="0,-4,0,0"/>
            <TextBlock Text="WAVE INCOMING!" FontFamily="Anton" FontSize="90" FontWeight="Bold" Foreground="Black" Margin="0,4,0,0"/>
            <TextBlock Text="WAVE INCOMING!" FontFamily="Anton" FontSize="90" FontWeight="Bold" Foreground="{StaticResource CreamBrush}"/>
        </Grid>
        <!-- Big countdown number -->
        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock Text="{Binding countdown, StringFormat=F0}" FontFamily="Anton" FontSize="400" FontWeight="Bold" Foreground="Black" Margin="-6,0,0,0"/>
            <TextBlock Text="{Binding countdown, StringFormat=F0}" FontFamily="Anton" FontSize="400" FontWeight="Bold" Foreground="Black" Margin="6,0,0,0"/>
            <TextBlock Text="{Binding countdown, StringFormat=F0}" FontFamily="Anton" FontSize="400" FontWeight="Bold" Foreground="Black" Margin="0,-6,0,0"/>
            <TextBlock Text="{Binding countdown, StringFormat=F0}" FontFamily="Anton" FontSize="400" FontWeight="Bold" Foreground="Black" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding countdown, StringFormat=F0}" FontFamily="Anton" FontSize="400" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
        </Grid>
    </Grid>

    <!-- Top HUD Bar - Lives (left), Wave (center), and Gold (right) -->
    <Grid VerticalAlignment="Top" Height="280" IsHitTestVisible="False" Background="Transparent">
        <!-- Border stroke overlay with rounded corners (no background) -->
        <Border CornerRadius="0,0,40,40" BorderThickness="0,0,0,6" BorderBrush="#553B14" Background="Transparent"/>
        <!-- Background fill Border with matching corners - contains content so clipping is enforced -->
        <Border CornerRadius="0,0,40,40" Background="Transparent">
            <Border CornerRadius="0,0,40,40" Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#F02a1a0e" Offset="0"/>
                        <GradientStop Color="#FF0a0500" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <!-- Content: Wave text centered -->
                <Grid Margin="80,30,80,30">

            <!-- Wave text in styled panel -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#CC1a1a2e"
                    BorderBrush="{StaticResource GoldBrush}"
                    BorderThickness="6"
                    CornerRadius="20"
                    Padding="30,15,40,15"
                    MinHeight="150">
                <Grid>
                    <!-- Corner Ornaments - Top Left -->
                    <Ellipse Width="22" Height="22" 
                             Fill="{StaticResource GoldBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-20,-8,0,0"/>
                    <Ellipse Width="14" Height="14" 
                             Fill="{StaticResource GoldDarkBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-16,-4,0,0"/>
                    <!-- Corner Ornaments - Top Right -->
                    <Ellipse Width="22" Height="22" 
                             Fill="{StaticResource GoldBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-8,-20,0"/>
                    <Ellipse Width="14" Height="14" 
                             Fill="{StaticResource GoldDarkBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-4,-16,0"/>
                    <!-- Corner Ornaments - Bottom Left -->
                    <Ellipse Width="22" Height="22" 
                             Fill="{StaticResource GoldBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-20,0,0,-8"/>
                    <Ellipse Width="14" Height="14" 
                             Fill="{StaticResource GoldDarkBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-16,0,0,-4"/>
                    <!-- Corner Ornaments - Bottom Right -->
                    <Ellipse Width="22" Height="22" 
                             Fill="{StaticResource GoldBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-20,-8"/>
                    <Ellipse Width="14" Height="14" 
                             Fill="{StaticResource GoldDarkBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-16,-4"/>

                    <!-- Wave text with outline -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="{Binding Path=waveText}" FontFamily="Anton"
                                       FontSize="120" FontWeight="Bold" Foreground="Black" Margin="-4,0,0,0"/>
                            <TextBlock Text="{Binding Path=waveText}" FontFamily="Anton"
                                       FontSize="120" FontWeight="Bold" Foreground="Black" Margin="4,0,0,0"/>
                            <TextBlock Text="{Binding Path=waveText}" FontFamily="Anton"
                                       FontSize="120" FontWeight="Bold" Foreground="Black" Margin="0,-4,0,0"/>
                            <TextBlock Text="{Binding Path=waveText}" FontFamily="Anton"
                                       FontSize="120" FontWeight="Bold" Foreground="Black" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Path=waveText}" FontFamily="Anton"
                                       FontSize="120" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>


        </Grid>
            </Border>
        </Border>
    </Grid>

    <!-- Abandon button - right of header bar, placed outside IsHitTestVisible=False header Grid so it can receive taps -->
    <Grid VerticalAlignment="Top" Height="280" IsHitTestVisible="True"
          Visibility="{Binding showAbandon, Converter={StaticResource BoolToVisConverter}}">
        <Border Margin="0,0,300,0" HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsHitTestVisible="True">
            <Button Command="{Binding events.abandonLevelTap}" CommandParameter="abandon"
                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                <Border Background="#CC1a1a2e"
                        BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="6"
                        CornerRadius="20"
                        Padding="30,15,30,15"
                        MinHeight="150">
                    <Grid>
                        <!-- Corner Ornaments - Top Left -->
                        <Ellipse Width="22" Height="22" 
                                 Fill="{StaticResource GoldBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="-20,-8,0,0"/>
                        <Ellipse Width="14" Height="14" 
                                 Fill="{StaticResource GoldDarkBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="-16,-4,0,0"/>
                        <!-- Corner Ornaments - Top Right -->
                        <Ellipse Width="22" Height="22" 
                                 Fill="{StaticResource GoldBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-8,-20,0"/>
                        <Ellipse Width="14" Height="14" 
                                 Fill="{StaticResource GoldDarkBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-4,-16,0"/>
                        <!-- Corner Ornaments - Bottom Left -->
                        <Ellipse Width="22" Height="22" 
                                 Fill="{StaticResource GoldBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                 Margin="-20,0,0,-8"/>
                        <Ellipse Width="14" Height="14" 
                                 Fill="{StaticResource GoldDarkBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                 Margin="-16,0,0,-4"/>
                        <!-- Corner Ornaments - Bottom Right -->
                        <Ellipse Width="22" Height="22" 
                                 Fill="{StaticResource GoldBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,-20,-8"/>
                        <Ellipse Width="14" Height="14" 
                                 Fill="{StaticResource GoldDarkBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,-16,-4"/>

                        <!-- Button content: flag icon only, left-aligned -->
                        <Viewbox Width="100" Height="130" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path Fill="{StaticResource CreamBrush}"
                                  Data="M4 1h2v22H4V1zm3 2h12l-3 4 3 4H7V3z"/>
                        </Viewbox>
                    </Grid>
                </Border>
            </Button>
        </Border>
    </Grid>

    <!-- Finish Level (Debug) Button - top-left, below the HUD bar, visible only during Wave phase -->
    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="80,300,0,0"
            Visibility="{Binding showFinishLevel, Converter={StaticResource BoolToVisConverter}}">
        <Button Command="{Binding events.finishLevelTap}" CommandParameter="finish"
                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
            <Border Background="#CC1a1a2e"
                    BorderBrush="#44CC44"
                    BorderThickness="4"
                    CornerRadius="14"
                    Padding="24,12,24,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Checkmark icon -->
                    <Viewbox Width="40" Height="40" Margin="0,0,10,0">
                        <Path Fill="#44CC44"
                              Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                    </Viewbox>
                    <!-- Text with outline -->
                    <Grid>
                        <TextBlock Text="FINISH" FontFamily="Anton" FontSize="44" FontWeight="Bold"
                                   Foreground="Black" Margin="-2,0,0,0"/>
                        <TextBlock Text="FINISH" FontFamily="Anton" FontSize="44" FontWeight="Bold"
                                   Foreground="Black" Margin="2,0,0,0"/>
                        <TextBlock Text="FINISH" FontFamily="Anton" FontSize="44" FontWeight="Bold"
                                   Foreground="Black" Margin="0,-2,0,0"/>
                        <TextBlock Text="FINISH" FontFamily="Anton" FontSize="44" FontWeight="Bold"
                                   Foreground="Black" Margin="0,2,0,0"/>
                        <TextBlock Text="FINISH" FontFamily="Anton" FontSize="44" FontWeight="Bold"
                                   Foreground="#44CC44"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Button>
    </Border>

    <!-- Kill Wave (Debug) Button - below Finish button, visible only during Wave phase -->
    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="80,400,0,0"
            Visibility="{Binding showNextWave, Converter={StaticResource BoolToVisConverter}}">
        <Button Command="{Binding events.nextWaveTap}" CommandParameter="nextwave"
                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
            <Border Background="#CC1a1a2e"
                    BorderBrush="#FF8844"
                    BorderThickness="4"
                    CornerRadius="14"
                    Padding="24,12,24,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Skull icon -->
                    <Viewbox Width="40" Height="40" Margin="0,0,10,0">
                        <Path Fill="#FF8844"
                              Data="M12 2C6.48 2 2 6.48 2 12c0 3.69 2.01 6.92 5 8.65V22h2v-1h2v1h2v-1h2v1h2v-1.35c2.99-1.73 5-4.96 5-8.65 0-5.52-4.48-10-10-10zm-3 14c-.83 0-1.5-.67-1.5-1.5S8.17 13 9 13s1.5.67 1.5 1.5S9.83 16 9 16zm6 0c-.83 0-1.5-.67-1.5-1.5S14.17 13 15 13s1.5.67 1.5 1.5S15.83 16 15 16z"/>
                    </Viewbox>
                    <!-- Text with outline -->
                    <Grid>
                        <TextBlock Text="KILL" FontFamily="Anton" FontSize="44" FontWeight="Bold"
                                   Foreground="Black" Margin="-2,0,0,0"/>
                        <TextBlock Text="KILL" FontFamily="Anton" FontSize="44" FontWeight="Bold"
                                   Foreground="Black" Margin="2,0,0,0"/>
                        <TextBlock Text="KILL" FontFamily="Anton" FontSize="44" FontWeight="Bold"
                                   Foreground="Black" Margin="0,-2,0,0"/>
                        <TextBlock Text="KILL" FontFamily="Anton" FontSize="44" FontWeight="Bold"
                                   Foreground="Black" Margin="0,2,0,0"/>
                        <TextBlock Text="KILL" FontFamily="Anton" FontSize="44" FontWeight="Bold"
                                   Foreground="#FF8844"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Button>
    </Border>


    <!-- Confirmation Popup Overlay -->
    <Grid Visibility="{Binding showConfirmPopup, Converter={StaticResource BoolToVisConverter}}">
        <!-- Semi-transparent dimmer background -->
        <Border Background="#AA000000"/>

        <!-- Popup panel centered -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F02a1a0e"
                BorderBrush="{StaticResource GoldBrush}"
                BorderThickness="6"
                CornerRadius="28"
                Padding="60,40,60,40"
                MinWidth="600">
            <Grid>
                <!-- Content -->
                <StackPanel HorizontalAlignment="Center">
                    <!-- Title text with outline -->
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,40">
                        <TextBlock FontFamily="Anton" FontSize="80" FontWeight="Bold"
                                   Foreground="Black" Text="Surrender?" Margin="-4,0,0,0" HorizontalAlignment="Center"/>
                        <TextBlock FontFamily="Anton" FontSize="80" FontWeight="Bold"
                                   Foreground="Black" Text="Surrender?" Margin="4,0,0,0" HorizontalAlignment="Center"/>
                        <TextBlock FontFamily="Anton" FontSize="80" FontWeight="Bold"
                                   Foreground="Black" Text="Surrender?" Margin="0,-4,0,0" HorizontalAlignment="Center"/>
                        <TextBlock FontFamily="Anton" FontSize="80" FontWeight="Bold"
                                   Foreground="Black" Text="Surrender?" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        <TextBlock FontFamily="Anton" FontSize="80" FontWeight="Bold" Text="Surrender?" HorizontalAlignment="Center"
                                   Foreground="{StaticResource CreamBrush}"/>
                    </Grid>

                    <!-- Buttons row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- YES button with breathing pulse -->
                        <Grid RenderTransformOrigin="0.5,0.5" ClipToBounds="False" Margin="0,0,40,0">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="GhYesScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Grid.Resources>
                                <Storyboard x:Key="GhYesPulseAnim" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="GhYesScale" Storyboard.TargetProperty="ScaleX"
                                                     From="1.0" To="1.01" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="GhYesScale" Storyboard.TargetProperty="ScaleY"
                                                     From="1.0" To="1.01" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="GhYesGlow" Storyboard.TargetProperty="Opacity"
                                                     From="0.0" To="0.2" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                                <Storyboard x:Key="GhYesPressAnim">
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhYesScale" Storyboard.TargetProperty="ScaleX">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.90"><EasingDoubleKeyFrame.EasingFunction><PowerEase EasingMode="EaseOut" Power="2"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0"><EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhYesScale" Storyboard.TargetProperty="ScaleY">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.90"><EasingDoubleKeyFrame.EasingFunction><PowerEase EasingMode="EaseOut" Power="2"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0"><EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </Grid.Resources>
                            <b:Interaction.Triggers>
                                <b:EventTrigger>
                                    <b:ControlStoryboardAction Storyboard="{StaticResource GhYesPulseAnim}"/>
                                </b:EventTrigger>
                                <b:EventTrigger EventName="MouseLeftButtonDown">
                                    <b:ControlStoryboardAction Storyboard="{StaticResource GhYesPressAnim}"/>
                                </b:EventTrigger>
                            </b:Interaction.Triggers>

                            <Border x:Name="GhYesGlow" Opacity="0" Background="Transparent"
                                    BorderBrush="#AAf5c518" BorderThickness="10" CornerRadius="26"
                                    Margin="-8,-8,-8,-8" IsHitTestVisible="False"/>

                            <Button Command="{Binding events.confirmYesTap}" CommandParameter="yes"
                                    Background="Transparent" BorderThickness="0" Padding="0">
                                <Border Background="#CC2e7d32"
                                        BorderBrush="{StaticResource GoldBrush}"
                                        BorderThickness="5"
                                        CornerRadius="18"
                                        Padding="50,20,50,20"
                                        MinWidth="220">
                                    <Grid HorizontalAlignment="Center">
                                        <TextBlock Text="YES" FontFamily="Anton" FontSize="64" FontWeight="Bold"
                                                   Foreground="Black" Margin="-3,0,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="YES" FontFamily="Anton" FontSize="64" FontWeight="Bold"
                                                   Foreground="Black" Margin="3,0,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="YES" FontFamily="Anton" FontSize="64" FontWeight="Bold"
                                                   Foreground="Black" Margin="0,-3,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="YES" FontFamily="Anton" FontSize="64" FontWeight="Bold"
                                                   Foreground="Black" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="YES" FontFamily="Anton" FontSize="64" FontWeight="Bold"
                                                   Foreground="{StaticResource CreamBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </Grid>

                        <!-- NO button with breathing pulse -->
                        <Grid RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="GhNoScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Grid.Resources>
                                <Storyboard x:Key="GhNoPulseAnim" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="GhNoScale" Storyboard.TargetProperty="ScaleX"
                                                     From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="GhNoScale" Storyboard.TargetProperty="ScaleY"
                                                     From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="GhNoGlow" Storyboard.TargetProperty="Opacity"
                                                     From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                                <Storyboard x:Key="GhNoPressAnim">
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhNoScale" Storyboard.TargetProperty="ScaleX">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.90"><EasingDoubleKeyFrame.EasingFunction><PowerEase EasingMode="EaseOut" Power="2"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0"><EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GhNoScale" Storyboard.TargetProperty="ScaleY">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.90"><EasingDoubleKeyFrame.EasingFunction><PowerEase EasingMode="EaseOut" Power="2"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0"><EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </Grid.Resources>
                            <b:Interaction.Triggers>
                                <b:EventTrigger>
                                    <b:ControlStoryboardAction Storyboard="{StaticResource GhNoPulseAnim}"/>
                                </b:EventTrigger>
                                <b:EventTrigger EventName="MouseLeftButtonDown">
                                    <b:ControlStoryboardAction Storyboard="{StaticResource GhNoPressAnim}"/>
                                </b:EventTrigger>
                            </b:Interaction.Triggers>

                            <Border x:Name="GhNoGlow" Opacity="0" Background="Transparent"
                                    BorderBrush="#AAf5c518" BorderThickness="10" CornerRadius="26"
                                    Margin="-8,-8,-8,-8" IsHitTestVisible="False"/>

                            <Button Command="{Binding events.confirmNoTap}" CommandParameter="no"
                                    Background="Transparent" BorderThickness="0" Padding="0">
                                <Border Background="#CCc62828"
                                        BorderBrush="{StaticResource GoldBrush}"
                                        BorderThickness="5"
                                        CornerRadius="18"
                                        Padding="50,20,50,20"
                                        MinWidth="220">
                                    <Grid HorizontalAlignment="Center">
                                        <TextBlock Text="NO" FontFamily="Anton" FontSize="64" FontWeight="Bold"
                                                   Foreground="Black" Margin="-3,0,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="NO" FontFamily="Anton" FontSize="64" FontWeight="Bold"
                                                   Foreground="Black" Margin="3,0,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="NO" FontFamily="Anton" FontSize="64" FontWeight="Bold"
                                                   Foreground="Black" Margin="0,-3,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="NO" FontFamily="Anton" FontSize="64" FontWeight="Bold"
                                                   Foreground="Black" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="NO" FontFamily="Anton" FontSize="64" FontWeight="Bold"
                                                   Foreground="{StaticResource CreamBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    </Grid>
</Page>
