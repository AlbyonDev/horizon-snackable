<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignWidth="1920" d:DesignHeight="1920">

    <Page.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="OverlayBrush" Color="#99000000"/>
        <SolidColorBrush x:Key="ParchmentBrush" Color="#1a1a2e"/>
        <SolidColorBrush x:Key="ParchmentDarkBrush" Color="#c0c0d0"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#f5c518"/>
        <SolidColorBrush x:Key="GoldDarkBrush" Color="#b8860b"/>
        <SolidColorBrush x:Key="VictoryBrush" Color="#2ecc71"/>
        <SolidColorBrush x:Key="DefeatBrush" Color="#e74c3c"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="#e0e0e0"/>
        <SolidColorBrush x:Key="WoodDarkBrush" Color="#4a2c0a"/>
        <SolidColorBrush x:Key="ShadowBrush" Color="#2a1a0a"/>
        <SolidColorBrush x:Key="CreamBrush" Color="#f5e6c8"/>
        <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

        <!-- Scale-in Animation Storyboard -->
        <Storyboard x:Key="ScaleInAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CentralPanel"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CentralPanel"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CentralPanel"
                                            Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>

    <!-- Main Container - Full Screen Overlay -->
    <Grid>
        <Grid.Visibility>
            <Binding Path="visible">
                <Binding.Converter>
                    <BooleanToVisibilityConverter/>
                </Binding.Converter>
            </Binding>
        </Grid.Visibility>

        <!-- Dark overlay background -->
        <Grid Background="{StaticResource OverlayBrush}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"/>

        <!-- Central Parchment Panel with Scale Animation -->
        <Grid x:Name="CentralPanel"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Parchment Panel with Gold Border -->
            <Border BorderBrush="{StaticResource GoldBrush}"
                    BorderThickness="16"
                    CornerRadius="32"
                    MinWidth="1400"
                    MinHeight="1200" Padding="50,50,50,50">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF000000" Offset="0"/>
                        <GradientStop Offset="1" Color="#FF1A1A2E"/>
                    </RadialGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Corner Ornaments -->
                    <!-- Top-Left -->
                    <Grid Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-22,-22,0,0">
                        <Ellipse Fill="{StaticResource GoldBrush}" Width="44" Height="44"/>
                        <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Top-Right -->
                    <Grid Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-22,-22,0">
                        <Ellipse Fill="{StaticResource GoldBrush}" Width="44" Height="44"/>
                        <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Bottom-Left -->
                    <Grid Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-22,0,0,-22">
                        <Ellipse Fill="{StaticResource GoldBrush}" Width="44" Height="44"/>
                        <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Bottom-Right -->
                    <Grid Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-22,-22">
                        <Ellipse Fill="{StaticResource GoldBrush}" Width="44" Height="44"/>
                        <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Main Content -->
                    <StackPanel>

                        <!-- Title on Wood Plank Ribbon Banner -->
                        <Grid HorizontalAlignment="Center" Height="200" Margin="0,40,0,60">
                            <!-- Wood Plank Background -->
                            <Image Source="/Root;component/Textures/WoodPlank.png"
                                   Stretch="Fill"
                                   Width="1000"
                                   Height="200"
                                   HorizontalAlignment="Center"/>

                            <!-- Victory Title (shown when isVictory=true) -->
                            <Grid x:Name="VictoryTitle" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="VICTORY" FontSize="144" FontWeight="Bold" Foreground="Black" Margin="6,0,0,0"/>
                                <TextBlock Text="VICTORY" FontSize="144" FontWeight="Bold" Foreground="Black" Margin="-6,0,0,0"/>
                                <TextBlock Text="VICTORY" FontSize="144" FontWeight="Bold" Foreground="Black" Margin="0,6,0,0"/>
                                <TextBlock Text="VICTORY" FontSize="144" FontWeight="Bold" Foreground="Black" Margin="0,-6,0,0"/>
                                <TextBlock Text="VICTORY" FontSize="144" FontWeight="Bold" Foreground="{StaticResource VictoryBrush}"/>
                            </Grid>

                            <!-- Defeat Title (shown when isVictory=false) -->
                            <Grid x:Name="DefeatTitle" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                                <TextBlock Text="DEFEAT" FontSize="144" FontWeight="Bold" Foreground="Black" Margin="6,0,0,0"/>
                                <TextBlock Text="DEFEAT" FontSize="144" FontWeight="Bold" Foreground="Black" Margin="-6,0,0,0"/>
                                <TextBlock Text="DEFEAT" FontSize="144" FontWeight="Bold" Foreground="Black" Margin="0,6,0,0"/>
                                <TextBlock Text="DEFEAT" FontSize="144" FontWeight="Bold" Foreground="Black" Margin="0,-6,0,0"/>
                                <TextBlock Text="DEFEAT" FontSize="144" FontWeight="Bold" Foreground="#FFDB5446"/>
                            </Grid>
                        </Grid>

                        <!-- Subtitle: Wave Progress -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,80">
                            <TextBlock Text="WAVE " FontSize="80" Foreground="{StaticResource ParchmentDarkBrush}"/>
                            <TextBlock Text="{Binding Path=wavesCompleted, StringFormat=F0}" FontSize="80" FontWeight="Bold" Foreground="{StaticResource ParchmentDarkBrush}"/>
                            <TextBlock Text="/" FontSize="80" Foreground="{StaticResource ParchmentDarkBrush}"/>
                            <TextBlock Text="{Binding Path=totalWaves, StringFormat=F0}" FontSize="80" FontWeight="Bold" Foreground="{StaticResource ParchmentDarkBrush}"/>
                        </StackPanel>

                        <!-- Stats Section -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,100">
                            <!-- Enemies Killed -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
                                <TextBlock Text="Enemies defeated: " FontSize="72" Foreground="{StaticResource TextDarkBrush}"/>
                                <TextBlock Text="{Binding Path=enemiesKilled, StringFormat=F0}" FontSize="72" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                            </StackPanel>

                            <!-- Gold Earned -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Gold earned: " FontSize="72" Foreground="{StaticResource TextDarkBrush}"/>
                                <Image Source="/Root;component/Textures/gold_icon.png"
                                       Width="80"
                                       Height="80"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding Path=goldEarned, StringFormat=F0}" FontSize="72" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                            </StackPanel>

                            <!-- Skulls Earned (victory only) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                                <StackPanel.Visibility>
                                    <Binding Path="showSkullsEarned">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </StackPanel.Visibility>
                                <TextBlock Text="Skulls earned: " FontSize="72" Foreground="{StaticResource TextDarkBrush}"/>
                                <Viewbox Width="80" Height="80" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <Grid Width="24" Height="24">
                                        <!-- Skull dome -->
                                        <Path Fill="#E8E8E8" Data="M12 2 C7 2 3 6 3 11 C3 14 4 16 6 17 L6 20 C6 21 7 22 8 22 L16 22 C17 22 18 21 18 20 L18 17 C20 16 21 14 21 11 C21 6 17 2 12 2 Z"/>
                                        <!-- Left eye socket -->
                                        <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                        <!-- Right eye socket -->
                                        <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,2"/>
                                        <!-- Nose -->
                                        <Path Fill="#1A1A2E" Data="M11 14 L12 16 L13 14 Z"/>
                                        <!-- Teeth -->
                                        <Path Fill="#1A1A2E" Data="M9 18 L9 20 M11 18 L11 20 M13 18 L13 20 M15 18 L15 20" StrokeThickness="0.8" Stroke="#1A1A2E"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="{Binding Path=skullsEarned, StringFormat=F0}" FontSize="72" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                                <TextBlock Text=" x2" FontSize="64" FontWeight="Bold" Foreground="#00E5CC" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock.Visibility>
                                        <Binding Path="showMultiplierIndicator">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- Buttons Row (defeat only) -->
                        <StackPanel x:Name="DefeatButtons" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Visibility>
                                <Binding Path="showDefeatButtons">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </StackPanel.Visibility>

                            <!-- RETURN TO OVERWORLD Button -->
                            <Grid Margin="0,0,40,0" RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                                <Grid.RenderTransform><ScaleTransform x:Name="OverworldBtnScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                                <Grid.Resources>
                                    <Storyboard x:Key="OverworldBtnPulse" RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="OverworldBtnScale" Storyboard.TargetProperty="ScaleX"
                                                         From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OverworldBtnScale" Storyboard.TargetProperty="ScaleY"
                                                         From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OverworldBtnGlow" Storyboard.TargetProperty="Opacity"
                                                         From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </Grid.Resources>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger>
                                        <b:ControlStoryboardAction Storyboard="{StaticResource OverworldBtnPulse}"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                                <Border x:Name="OverworldBtnGlow" Opacity="0" Background="Transparent"
                                        BorderBrush="#AAf5c518" BorderThickness="10" CornerRadius="30"
                                        Width="652" Height="232" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                <Button Command="{Binding Path=events.overworldTap}"
                                        Background="{StaticResource TransparentBrush}"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="0" Height="200" Width="620">
                                    <Border Background="{StaticResource ParchmentBrush}"
                                            BorderBrush="{StaticResource GoldBrush}"
                                            BorderThickness="12"
                                            CornerRadius="24"
                                            Height="200" Width="620">
                                        <Grid>
                                            <!-- Button Corner Ornaments (smaller) -->
                                            <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0">
                                                <Ellipse Fill="{StaticResource GoldBrush}" Width="32" Height="32"/>
                                                <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                                                <Ellipse Fill="{StaticResource GoldBrush}" Width="32" Height="32"/>
                                                <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12">
                                                <Ellipse Fill="{StaticResource GoldBrush}" Width="32" Height="32"/>
                                                <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12">
                                                <Ellipse Fill="{StaticResource GoldBrush}" Width="32" Height="32"/>
                                                <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Outlined Text "OVERWORLD" -->
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="OVERWORLD" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="6,0,0,0"/>
                                                <TextBlock Text="OVERWORLD" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="-6,0,0,0"/>
                                                <TextBlock Text="OVERWORLD" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="0,6,0,0"/>
                                                <TextBlock Text="OVERWORLD" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="0,-6,0,0"/>
                                                <TextBlock Text="OVERWORLD" FontSize="84" FontWeight="Bold" Foreground="{StaticResource CreamBrush}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                            </Grid>

                            <!-- PLAY AGAIN Button with 3D Medieval Style -->
                            <Grid RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                                <Grid.RenderTransform><ScaleTransform x:Name="PlayAgainBtnScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                                <Grid.Resources>
                                    <Storyboard x:Key="PlayAgainBtnPulse" RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PlayAgainBtnScale" Storyboard.TargetProperty="ScaleX"
                                                         From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PlayAgainBtnScale" Storyboard.TargetProperty="ScaleY"
                                                         From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PlayAgainBtnGlow" Storyboard.TargetProperty="Opacity"
                                                         From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </Grid.Resources>
                                <b:Interaction.Triggers>
                                    <b:EventTrigger>
                                        <b:ControlStoryboardAction Storyboard="{StaticResource PlayAgainBtnPulse}"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                                <Border x:Name="PlayAgainBtnGlow" Opacity="0" Background="Transparent"
                                        BorderBrush="#AAf5c518" BorderThickness="10" CornerRadius="30"
                                        Width="652" Height="232" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                <Button Command="{Binding Path=events.restartTap}"
                                        Background="{StaticResource TransparentBrush}"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="0" Height="200" Width="620">
                                    <Border Background="{StaticResource WoodDarkBrush}"
                                            BorderBrush="{StaticResource GoldBrush}"
                                            BorderThickness="12"
                                            CornerRadius="24"
                                            Height="200" Width="620">
                                        <Grid>
                                            <!-- Button Corner Ornaments (smaller) -->
                                            <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0">
                                                <Ellipse Fill="{StaticResource GoldBrush}" Width="32" Height="32"/>
                                                <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                                                <Ellipse Fill="{StaticResource GoldBrush}" Width="32" Height="32"/>
                                                <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12">
                                                <Ellipse Fill="{StaticResource GoldBrush}" Width="32" Height="32"/>
                                                <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12">
                                                <Ellipse Fill="{StaticResource GoldBrush}" Width="32" Height="32"/>
                                                <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Outlined Text "PLAY AGAIN" -->
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="PLAY AGAIN" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="6,0,0,0"/>
                                                <TextBlock Text="PLAY AGAIN" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="-6,0,0,0"/>
                                                <TextBlock Text="PLAY AGAIN" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="0,6,0,0"/>
                                                <TextBlock Text="PLAY AGAIN" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="0,-6,0,0"/>
                                                <TextBlock Text="PLAY AGAIN" FontSize="84" FontWeight="Bold" Foreground="{StaticResource CreamBrush}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                            </Grid>

                        </StackPanel>

                        <!-- CHOOSE RELIC Button (regular victory only) -->
                        <Grid x:Name="ChooseRelicButton" HorizontalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                            <Grid.RenderTransform><ScaleTransform x:Name="ChooseRelicBtnScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                            <Grid.Resources>
                                <Storyboard x:Key="ChooseRelicBtnPulse" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="ChooseRelicBtnScale" Storyboard.TargetProperty="ScaleX"
                                                     From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="ChooseRelicBtnScale" Storyboard.TargetProperty="ScaleY"
                                                     From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="ChooseRelicBtnGlow" Storyboard.TargetProperty="Opacity"
                                                     From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </Grid.Resources>
                            <b:Interaction.Triggers>
                                <b:EventTrigger>
                                    <b:ControlStoryboardAction Storyboard="{StaticResource ChooseRelicBtnPulse}"/>
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                            <Border x:Name="ChooseRelicBtnGlow" Opacity="0" Background="Transparent"
                                    BorderBrush="#AAf5c518" BorderThickness="10" CornerRadius="30"
                                    Width="732" Height="232" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"/>
                            <Grid.Visibility>
                                <Binding Path="showChooseRelic">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Grid.Visibility>
                            <Button Command="{Binding Path=events.chooseRelicTap}"
                                    Background="{StaticResource TransparentBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="0" Height="200" Width="700">
                                <Border BorderBrush="{StaticResource VictoryBrush}"
                                        BorderThickness="12"
                                        CornerRadius="24"
                                        Height="200" Width="700">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1a5632" Offset="0"/>
                                            <GradientStop Color="#0d3a1f" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <!-- Corner ornaments -->
                                        <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0">
                                            <Ellipse Fill="{StaticResource VictoryBrush}" Width="32" Height="32"/>
                                            <Ellipse Fill="#1a5632" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                                            <Ellipse Fill="{StaticResource VictoryBrush}" Width="32" Height="32"/>
                                            <Ellipse Fill="#1a5632" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12">
                                            <Ellipse Fill="{StaticResource VictoryBrush}" Width="32" Height="32"/>
                                            <Ellipse Fill="#1a5632" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12">
                                            <Ellipse Fill="{StaticResource VictoryBrush}" Width="32" Height="32"/>
                                            <Ellipse Fill="#1a5632" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Outlined Text "CHOOSE RELIC" -->
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="CHOOSE RELIC" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="6,0,0,0"/>
                                            <TextBlock Text="CHOOSE RELIC" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="-6,0,0,0"/>
                                            <TextBlock Text="CHOOSE RELIC" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="0,6,0,0"/>
                                            <TextBlock Text="CHOOSE RELIC" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="0,-6,0,0"/>
                                            <TextBlock Text="CHOOSE RELIC" FontSize="84" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                        </Grid>

                        <!-- NEXT RUN Button (boss victory only) -->
                        <Grid x:Name="NextRunButton" HorizontalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                            <Grid.RenderTransform><ScaleTransform x:Name="NextRunBtnScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                            <Grid.Resources>
                                <Storyboard x:Key="NextRunBtnPulse" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="NextRunBtnScale" Storyboard.TargetProperty="ScaleX"
                                                     From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="NextRunBtnScale" Storyboard.TargetProperty="ScaleY"
                                                     From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="NextRunBtnGlow" Storyboard.TargetProperty="Opacity"
                                                     From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </Grid.Resources>
                            <b:Interaction.Triggers>
                                <b:EventTrigger>
                                    <b:ControlStoryboardAction Storyboard="{StaticResource NextRunBtnPulse}"/>
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                            <Border x:Name="NextRunBtnGlow" Opacity="0" Background="Transparent"
                                    BorderBrush="#AAf5c518" BorderThickness="10" CornerRadius="30"
                                    Width="732" Height="232" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"/>
                            <Grid.Visibility>
                                <Binding Path="showNextRun">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Grid.Visibility>
                            <Button Command="{Binding Path=events.nextRunTap}"
                                    Background="{StaticResource TransparentBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="0" Height="200" Width="700">
                                <Border BorderBrush="{StaticResource GoldBrush}"
                                        BorderThickness="12"
                                        CornerRadius="24"
                                        Height="200" Width="700">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4a2c0a" Offset="0"/>
                                            <GradientStop Color="#2a1a0a" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <!-- Corner ornaments -->
                                        <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0">
                                            <Ellipse Fill="{StaticResource GoldBrush}" Width="32" Height="32"/>
                                            <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                                            <Ellipse Fill="{StaticResource GoldBrush}" Width="32" Height="32"/>
                                            <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12">
                                            <Ellipse Fill="{StaticResource GoldBrush}" Width="32" Height="32"/>
                                            <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12">
                                            <Ellipse Fill="{StaticResource GoldBrush}" Width="32" Height="32"/>
                                            <Ellipse Fill="{StaticResource GoldDarkBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Outlined Text "NEXT RUN" -->
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="NEXT RUN" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="6,0,0,0"/>
                                            <TextBlock Text="NEXT RUN" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="-6,0,0,0"/>
                                            <TextBlock Text="NEXT RUN" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="0,6,0,0"/>
                                            <TextBlock Text="NEXT RUN" FontSize="84" FontWeight="Bold" Foreground="Black" Margin="0,-6,0,0"/>
                                            <TextBlock Text="NEXT RUN" FontSize="84" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                        </Grid>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- DataTriggers for Victory/Defeat state and Scale Animation -->
        <b:Interaction.Triggers>
            <!-- Victory state -->
            <b:DataTrigger Binding="{Binding Path=isVictory}" Value="True">
                <b:ChangePropertyAction TargetName="VictoryTitle" PropertyName="Visibility" Value="Visible"/>
                <b:ChangePropertyAction TargetName="DefeatTitle" PropertyName="Visibility" Value="Collapsed"/>
            </b:DataTrigger>
            <!-- Defeat state -->
            <b:DataTrigger Binding="{Binding Path=isVictory}" Value="False">
                <b:ChangePropertyAction TargetName="VictoryTitle" PropertyName="Visibility" Value="Collapsed"/>
                <b:ChangePropertyAction TargetName="DefeatTitle" PropertyName="Visibility" Value="Visible"/>
            </b:DataTrigger>
            <!-- Scale-in animation when visible becomes True -->
            <b:DataTrigger Binding="{Binding Path=visible}" Value="True">
                <b:ControlStoryboardAction Storyboard="{StaticResource ScaleInAnimation}"/>
            </b:DataTrigger>
        </b:Interaction.Triggers>
    </Grid>
</Page>
