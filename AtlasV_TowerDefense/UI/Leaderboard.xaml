<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d">

    <!-- Main Container - Full Screen -->
    <Grid>
        <Grid.Visibility>
            <Binding Path="visible">
                <Binding.Converter>
                    <BooleanToVisibilityConverter/>
                </Binding.Converter>
            </Binding>
        </Grid.Visibility>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#FF000000" Offset="0"/>
                <GradientStop Offset="1" Color="#FF1A1A2E"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Content Layout -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="48,80,48,80">
            <Grid.RowDefinitions>
                <!-- Row 0: Title -->
                <RowDefinition Height="220"/>
                <!-- Row 1: Tab buttons -->
                <RowDefinition Height="260"/>
                <!-- Row 2: Divider -->
                <RowDefinition Height="12"/>
                <!-- Row 3: Column Headers -->
                <RowDefinition Height="Auto"/>
                <!-- Row 4: Entry list -->
                <RowDefinition Height="*"/>
                <!-- Row 5: Back button -->
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title -->
            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="LEADERBOARD" FontSize="144" FontWeight="Bold" FontFamily="Anton"
                           Foreground="Black" Margin="-6,0,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="LEADERBOARD" FontSize="144" FontWeight="Bold" FontFamily="Anton"
                           Foreground="Black" Margin="6,0,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="LEADERBOARD" FontSize="144" FontWeight="Bold" FontFamily="Anton"
                           Foreground="Black" Margin="0,-6,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="LEADERBOARD" FontSize="144" FontWeight="Bold" FontFamily="Anton"
                           Foreground="Black" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="LEADERBOARD" FontSize="144" FontWeight="Bold" FontFamily="Anton"
                           Foreground="#FFF5E6C8" HorizontalAlignment="Center"/>
            </Grid>

            <!-- Row 1: Biome Tab Buttons -->
            <Grid Grid.Row="1" Margin="24,0,24,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Grass Tab -->
              <Button Grid.Column="0" Command="{Binding Path=events.grassTab}"
                      Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Opacity="{Binding grassTabOpacity}">
                <Border CornerRadius="16" BorderThickness="5" BorderBrush="#FF4CAF50"
                        Background="#33228B22" Height="210" HorizontalAlignment="Stretch">
                  <TextBlock Text="GRASS" FontSize="92" FontFamily="Anton"
                             Foreground="#FF4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Button>

              <!-- Snow Tab -->
              <Button Grid.Column="2" Command="{Binding Path=events.snowTab}"
                      Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Opacity="{Binding snowTabOpacity}">
                <Border CornerRadius="16" BorderThickness="5" BorderBrush="#FF64B5F6"
                        Background="#3300BFFF" Height="210" HorizontalAlignment="Stretch">
                  <TextBlock Text="SNOW" FontSize="92" FontFamily="Anton"
                             Foreground="#FF64B5F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Button>

              <!-- Volcano Tab -->
              <Button Grid.Column="4" Command="{Binding Path=events.volcanoTab}"
                      Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Opacity="{Binding volcanoTabOpacity}">
                <Border CornerRadius="16" BorderThickness="5" BorderBrush="#FFFF7043"
                        Background="#33FF4500" Height="210" HorizontalAlignment="Stretch">
                  <TextBlock Text="VOLCANO" FontSize="92" FontFamily="Anton"
                             Foreground="#FFFF7043" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Button>
            </Grid>

            <!-- Row 2: Divider line -->
            <Rectangle Grid.Row="2" Fill="#44f5c518" Margin="24,0,24,0" Height="5"/>

            <!-- Row 3: Column Headers -->
            <Border Grid.Row="3" Margin="24,12,24,0" CornerRadius="10"
                    Background="#33f5c518" BorderThickness="0,0,0,3" BorderBrush="#55f5c518"
                    Padding="0,14,0,14">
                <Grid Margin="24,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="580"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Rank" FontSize="62" FontFamily="Anton"
                               FontWeight="Bold" Foreground="#FFf5c518" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Name" FontSize="62" FontFamily="Anton"
                               FontWeight="Bold" Foreground="#FFf5c518" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Boss Killed Count" FontSize="62" FontFamily="Anton"
                               FontWeight="Bold" Foreground="#FFf5c518" VerticalAlignment="Center"
                               HorizontalAlignment="Right" TextAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Row 4: Entries list -->
            <Grid Grid.Row="4" Margin="24,20,24,0">
              <!-- Empty state text -->
              <TextBlock Text="No boss kills yet"
                         Visibility="{Binding emptyStateVisibility}"
                         FontSize="72" FontFamily="Anton"
                         Foreground="#66FFFFFF"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>

              <!-- Entries list -->
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding entries}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,16,0,16" CornerRadius="12"
                              BorderThickness="3" BorderBrush="#33f5c518"
                              Background="#22000000" Height="170">
                        <Grid Margin="24,0,24,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="580"/>
                          </Grid.ColumnDefinitions>

                          <!-- Rank -->
                          <TextBlock Grid.Column="0" Text="{Binding rank}"
                                     FontSize="96" FontFamily="Anton"
                                     Foreground="#FFf5c518"
                                     VerticalAlignment="Center"/>
                          <!-- Player Name -->
                          <TextBlock Grid.Column="1" Text="{Binding playerName}"
                                     FontSize="76" FontFamily="Anton"
                                     Foreground="#DDFFFFFF"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <!-- Score -->
                          <TextBlock Grid.Column="2" Text="{Binding score}"
                                     FontSize="100" FontFamily="Anton"
                                     Foreground="#FFffd84a"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>

            <!-- Row 5: Back Button -->
            <Grid Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{Binding Path=events.close}"
                        Background="Transparent" BorderThickness="0"
                        Padding="0" Cursor="Hand">
                    <Border CornerRadius="20" BorderThickness="5" BorderBrush="#AAf5c518"
                            Padding="120,32,120,32" Background="#44000000">
                        <TextBlock Text="BACK" FontSize="80" FontFamily="Anton"
                                   Foreground="#CCf5c518" HorizontalAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
