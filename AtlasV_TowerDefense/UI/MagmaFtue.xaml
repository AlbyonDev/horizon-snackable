<Component xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:noesis="clr-namespace:NoesisGUIExtensions"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           mc:Ignorable="d"
           d:DesignWidth="1080" d:DesignHeight="1920">

  <noesis:LayoutScaler ReferenceResolution="1080,1920">
    <Grid>
      <!-- Full-screen dark overlay -->
      <Grid Background="#CC000000">
        <Grid.Visibility>
          <Binding Path="visible">
            <Binding.Converter>
              <BooleanToVisibilityConverter/>
            </Binding.Converter>
          </Binding>
        </Grid.Visibility>
      </Grid>

      <!-- Popup panel (centered) -->
      <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="60,0,60,0">
        <Grid.Visibility>
          <Binding Path="visible">
            <Binding.Converter>
              <BooleanToVisibilityConverter/>
            </Binding.Converter>
          </Binding>
        </Grid.Visibility>

        <Border Background="#EE1a1a2e"
                BorderBrush="#ff6600"
                BorderThickness="6"
                CornerRadius="24"
                Padding="40,28,40,28"
                MaxWidth="900">
          <StackPanel HorizontalAlignment="Center">
            <!-- Title with fiery gold outline -->
            <Grid HorizontalAlignment="Center" Margin="0,0,0,12">
              <TextBlock Text="VOLCANIC HAZARD" FontFamily="Anton"
                         FontSize="64" FontWeight="Bold" Foreground="Black" Margin="-3,0,0,0"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="VOLCANIC HAZARD" FontFamily="Anton"
                         FontSize="64" FontWeight="Bold" Foreground="Black" Margin="3,0,0,0"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="VOLCANIC HAZARD" FontFamily="Anton"
                         FontSize="64" FontWeight="Bold" Foreground="Black" Margin="0,-3,0,0"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="VOLCANIC HAZARD" FontFamily="Anton"
                         FontSize="64" FontWeight="Bold" Foreground="Black" Margin="0,3,0,0"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="VOLCANIC HAZARD" FontFamily="Anton"
                         FontSize="64" FontWeight="Bold" Foreground="#f5c518"
                         HorizontalAlignment="Center"/>
            </Grid>

            <!-- Body text -->
            <TextBlock Text="Magma tiles block tower placement. The higher your run, the more magma tiles appear!"
                       FontFamily="Almendra" FontSize="46"
                       Foreground="#dddddd"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,0,0,24"/>

            <!-- Got it! button (same green style as minigame FTUE) -->
            <Button Command="{Binding events.gotIt}"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="0,4,0,0">
              <Border Background="#ff6600"
                      CornerRadius="16"
                      Padding="52,14,52,14">
                <TextBlock Text="Got it!" FontFamily="Anton"
                           FontSize="52" FontWeight="Bold"
                           Foreground="#1a1a2e"
                           HorizontalAlignment="Center"/>
              </Border>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </noesis:LayoutScaler>
</Component>
