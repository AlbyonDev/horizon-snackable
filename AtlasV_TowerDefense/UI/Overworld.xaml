            </Grid>
        </Grid>

        <!-- Relic carousel overlay (fullscreen) -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.Visibility>
                <Binding Path="carouselVisible">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter/>
                    </Binding.Converter>
                </Binding>
            </Grid.Visibility>

            <Border Background="#CC000000">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseLeftButtonUp">
                        <b:InvokeCommandAction Command="{Binding events.relicCarouselTap}" CommandParameter="close"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </Border>

            <!-- Vertical layout: Cards -> Dots -> Title — pushed to upper portion of screen -->
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.08*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0.02*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0.02*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0.08*"/>
                </Grid.RowDefinitions>

                <!-- Cards area -->
                <Canvas Grid.Row="1" HorizontalAlignment="Center" Width="1800" Height="1800">
                    <ItemsControl ItemsSource="{Binding carouselCards}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding cardLeft}"/>
                                <Setter Property="Canvas.Top" Value="{Binding cardTop}"/>
                                <Setter Property="Canvas.ZIndex" Value="{Binding cardZIndex}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding cardWidth}" Height="{Binding cardHeight}" CornerRadius="24" BorderThickness="5" BorderBrush="{StaticResource GoldBrush}" Opacity="{Binding cardOpacity}" RenderTransformOrigin="0.5,0.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF2A1A0A" Offset="0"/>
                                            <GradientStop Color="#FF1A1008" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding cardScaleX}" ScaleY="{Binding cardScaleY}"/>
                                    </Border.RenderTransform>
                                    <Grid Margin="32">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Width="700" Height="700" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Background><ImageBrush ImageSource="{Binding icon}" Stretch="Uniform"/></Border.Background>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding relicName}" FontFamily="Almendra" FontSize="96" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextAlignment="Center" TextWrapping="Wrap" Margin="12,12,12,4"/>
                                        <TextBlock Grid.Row="2" Text="{Binding relicDescription}" FontFamily="Almendra" FontSize="68" Foreground="{StaticResource ParchmentBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" TextWrapping="Wrap" TextAlignment="Center" Margin="12,4,12,16"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>

                <!-- Dot indicators - just below cards -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding carouselDots}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="{Binding dotSize}" Height="{Binding dotSize}" Margin="12,0" Fill="{Binding dotColor}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Title "YOUR RELICS" - below dots, styled panel -->
                <Border Grid.Row="5" HorizontalAlignment="Center"
                        Background="#CC1a1a2e"
                        BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="5"
                        CornerRadius="18"
                        Padding="48,14,48,14">
                    <Grid>
                        <!-- Corner Ornaments -->
                        <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"/>
                        <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="11,11,0,0"/>
                        <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"/>
                        <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,11,0"/>
                        <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                        <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="11,0,0,11"/>
                        <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
                        <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,11,11"/>
                        <!-- Text with outline -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,8,32,8">
                            <TextBlock Text="YOUR RELICS" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="Black" Margin="-4,0,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="YOUR RELICS" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="Black" Margin="4,0,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="YOUR RELICS" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="Black" Margin="0,-4,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="YOUR RELICS" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="Black" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="YOUR RELICS" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>


            </Grid>

            <!-- Swipe detection grid (overlays the full carousel area for reliable swipe detection) -->
            <!-- 15 zones for highly responsive swipe detection -->
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="Transparent">
