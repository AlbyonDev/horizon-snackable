                                <Ellipse Width="14" Height="14" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0"/>
                                <Ellipse Width="10" Height="10" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"/>
                                <Ellipse Width="14" Height="14" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"/>
                                <Ellipse Width="10" Height="10" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"/>
                                <Ellipse Width="14" Height="14" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                                <Ellipse Width="10" Height="10" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                                <Ellipse Width="14" Height="14" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"/>
                                <Ellipse Width="10" Height="10" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28,8,28,8">
                                    <Viewbox Width="72" Height="72" Margin="0,0,12,0">
                                        <Grid Width="24" Height="24">
                                            <Path Fill="#9b59b6" Data="M12 1 L7 4 L5 10 L7 18 L12 23 L17 18 L19 10 L17 4 Z"/>
                                            <Path Fill="#c39bd3" Data="M12 3 L9 5 L8 10 L12 14 L16 10 L15 5 Z" Opacity="0.7"/>
                                        </Grid>
                                    </Viewbox>
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="RELICS" FontFamily="Anton" FontSize="56" FontWeight="Bold" Foreground="Black" Margin="-2,0,0,0"/>
                                        <TextBlock Text="RELICS" FontFamily="Anton" FontSize="56" FontWeight="Bold" Foreground="Black" Margin="2,0,0,0"/>
                                        <TextBlock Text="RELICS" FontFamily="Anton" FontSize="56" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                                    </Grid>
                                    <Grid VerticalAlignment="Center" Margin="12,0,0,0">
