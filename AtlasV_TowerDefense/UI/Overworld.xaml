                    <Binding.Converter>
                        <BooleanToVisibilityConverter/>
                    </Binding.Converter>
                </Binding>
            </Grid.Visibility>

            <!-- UNLOCKED version (animated, biome icons + arrow) -->
            <Grid RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding biomeArrowRightLocked}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RenderTransform><ScaleTransform x:Name="BiomeArrowScaleTransform" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                <Grid.Resources>
                    <Storyboard x:Key="BiomeArrowPulseAnim" RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="BiomeArrowScaleTransform"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="1.0" To="1.08" Duration="0:0:0.9" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="BiomeArrowScaleTransform"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="1.0" To="1.08" Duration="0:0:0.9" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="BiomeArrowGlowBorder"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                    <Storyboard x:Key="BiomeArrowPressAnim">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BiomeArrowScaleTransform" Storyboard.TargetProperty="ScaleX">
                            <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.90"><EasingDoubleKeyFrame.EasingFunction><PowerEase EasingMode="EaseOut" Power="2"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0"><EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BiomeArrowScaleTransform" Storyboard.TargetProperty="ScaleY">
                            <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.90"><EasingDoubleKeyFrame.EasingFunction><PowerEase EasingMode="EaseOut" Power="2"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0"><EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </Grid.Resources>
