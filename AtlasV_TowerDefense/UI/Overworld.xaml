                        <!-- Main RELICS border (no animation, no glow) -->
                        <Border Background="#CC1a1a2e"
                                BorderBrush="{StaticResource GoldBrush}"
                                BorderThickness="4" CornerRadius="16" Padding="24,10,24,10">
