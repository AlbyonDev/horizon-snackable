<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d">

    <Page.Resources>
        <!-- Fantasy adventure map colors -->
        <SolidColorBrush x:Key="GoldBrush" Color="#FFf5c518"/>
        <SolidColorBrush x:Key="TextLightBrush" Color="#FFF5E6C8"/>
        <SolidColorBrush x:Key="ParchmentBrush" Color="#FFF5E6C8"/>
        <SolidColorBrush x:Key="DarkStoneBrush" Color="#FF2A1A0A"/>
        <!-- Path stroke: warm stone tan for the winding trail -->
        <SolidColorBrush x:Key="PathStrokeBrush" Color="#FFC4A44A"/>
        <SolidColorBrush x:Key="PathStrokeOuterBrush" Color="#FF9A7B30"/>

        <!-- Canvas panel for absolute positioning -->
        <ItemsPanelTemplate x:Key="CanvasPanel">
            <Canvas/>
        </ItemsPanelTemplate>

        <!-- Node container style: positions each node on the canvas -->
        <Style x:Key="NodeContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding posX}"/>
            <Setter Property="Canvas.Top" Value="{Binding posY}"/>
        </Style>

        <!-- Vertical panel for relic icons column (unused, kept for reference) -->
        <ItemsPanelTemplate x:Key="VerticalRelicPanel">
            <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>

        <!-- Level Node template with state-driven sprites -->
        <DataTemplate x:Key="LevelNodeTemplate">
            <Grid Width="{Binding nodeSize}" Height="{Binding nodeSize}" ClipToBounds="False">
                <Grid.Resources>
                    <!-- Looping breathing scale for open node sprites: 1.0 → 1.18 → 1.0 over 1.6s -->
                    <Storyboard x:Key="NodeBreathingAnim" RepeatBehavior="Forever">
                        <!-- CombatOpenSprite ScaleX -->
                        <DoubleAnimation Storyboard.TargetName="CombatOpenSprite"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         From="1.0" To="1.18" Duration="0:0:0.8" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <!-- CombatOpenSprite ScaleY -->
                        <DoubleAnimation Storyboard.TargetName="CombatOpenSprite"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         From="1.0" To="1.18" Duration="0:0:0.8" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <!-- BossOpenSprite ScaleX -->
                        <DoubleAnimation Storyboard.TargetName="BossOpenSprite"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         From="1.0" To="1.18" Duration="0:0:0.8" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <!-- BossOpenSprite ScaleY -->
                        <DoubleAnimation Storyboard.TargetName="BossOpenSprite"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         From="1.0" To="1.18" Duration="0:0:0.8" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <!-- MinigameOpenSprite ScaleX -->
                        <DoubleAnimation Storyboard.TargetName="MinigameOpenSprite"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         From="1.0" To="1.18" Duration="0:0:0.8" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <!-- MinigameOpenSprite ScaleY -->
                        <DoubleAnimation Storyboard.TargetName="MinigameOpenSprite"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         From="1.0" To="1.18" Duration="0:0:0.8" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Grid.Resources>

                <!-- Auto-play breathing scale animation on load -->
                <b:Interaction.Triggers>
                    <b:EventTrigger>
                        <b:ControlStoryboardAction Storyboard="{DynamicResource NodeBreathingAnim}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>


                <Grid Width="{Binding nodeSize}" Height="{Binding nodeSize}">
                <!-- Tap handler -->
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseLeftButtonUp">
                        <b:InvokeCommandAction Command="{Binding DataContext.events.levelTap, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding levelIndex}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>

                <!-- === COMBAT NODE SPRITES (nodeType=combat) === -->
                <Image Source="sprites/overworld_node_combat.png" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="combat"/>
                                        <Condition Binding="{Binding nodeState}" Value="beaten"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image x:Name="CombatOpenSprite" Source="sprites/overworld_node_combat_open.png" Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Image.RenderTransform>
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="combat"/>
                                        <Condition Binding="{Binding nodeState}" Value="open"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image Source="sprites/overworld_node_combat_locked.png" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="combat"/>
                                        <Condition Binding="{Binding nodeState}" Value="locked"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <!-- === BOSS NODE SPRITES (nodeType=boss) === -->
                <Image Source="sprites/overworld_node_boss.png" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="boss"/>
                                        <Condition Binding="{Binding nodeState}" Value="beaten"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image x:Name="BossOpenSprite" Source="sprites/overworld_node_boss_open.png" Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Image.RenderTransform>
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="boss"/>
                                        <Condition Binding="{Binding nodeState}" Value="open"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image Source="sprites/overworld_node_boss_locked.png" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="boss"/>
                                        <Condition Binding="{Binding nodeState}" Value="locked"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <!-- === MINIGAME NODE SPRITES (nodeType=minigame) === -->
                <Image Source="sprites/overworld_node_minigame.png" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="minigame"/>
                                        <Condition Binding="{Binding nodeState}" Value="beaten"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image x:Name="MinigameOpenSprite" Source="sprites/overworld_node_minigame_open.png" Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Image.RenderTransform>
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="minigame"/>
                                        <Condition Binding="{Binding nodeState}" Value="open"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image Source="sprites/overworld_node_minigame_locked.png" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="minigame"/>
                                        <Condition Binding="{Binding nodeState}" Value="locked"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                </Grid>

                <!-- Boss modifier label (shown to the right of the node for boss type only) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                        CornerRadius="12" Padding="28,16" BorderThickness="4"
                        Width="420"
                        BorderBrush="{StaticResource GoldBrush}" Background="#F00d0d1a">
                    <Border.RenderTransform>
                        <TranslateTransform X="{Binding modifierOffsetX}"/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding nodeType}" Value="boss">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="BOSS MODIFIER" FontSize="38" FontWeight="Bold"
                                       FontFamily="Anton" Foreground="#FF1A1A0A"
                                       HorizontalAlignment="Center" Margin="-2,0,0,0"/>
                            <TextBlock Text="BOSS MODIFIER" FontSize="38" FontWeight="Bold"
                                       FontFamily="Anton" Foreground="#FF1A1A0A"
                                       HorizontalAlignment="Center" Margin="2,0,0,0"/>
                            <TextBlock Text="BOSS MODIFIER" FontSize="38" FontWeight="Bold"
                                       FontFamily="Anton" Foreground="#FF1A1A0A"
                                       HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            <TextBlock Text="BOSS MODIFIER" FontSize="38" FontWeight="Bold"
                                       FontFamily="Anton" Foreground="#FF1A1A0A"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="BOSS MODIFIER" FontSize="38" FontWeight="Bold"
                                       FontFamily="Anton" Foreground="{StaticResource GoldBrush}"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                        <Grid HorizontalAlignment="Center" MaxWidth="360">
                            <TextBlock Text="{Binding modifierLabel}" FontSize="50" FontWeight="Bold"
                                       FontFamily="Anton" Foreground="#FF1A1A0A"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" Margin="-2,0,0,0"/>
                            <TextBlock Text="{Binding modifierLabel}" FontSize="50" FontWeight="Bold"
                                       FontFamily="Anton" Foreground="#FF1A1A0A"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" Margin="2,0,0,0"/>
                            <TextBlock Text="{Binding modifierLabel}" FontSize="50" FontWeight="Bold"
                                       FontFamily="Anton" Foreground="#FF1A1A0A"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,-2,0,0"/>
                            <TextBlock Text="{Binding modifierLabel}" FontSize="50" FontWeight="Bold"
                                       FontFamily="Anton" Foreground="#FF1A1A0A"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding modifierLabel}" FontSize="50" FontWeight="Bold"
                                       FontFamily="Anton" Foreground="{StaticResource GoldBrush}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- Main Container -->
    <Grid>
        <Grid.Visibility>
            <Binding Path="visible">
                <Binding.Converter>
                    <BooleanToVisibilityConverter/>
                </Binding.Converter>
            </Binding>
        </Grid.Visibility>

        <!-- Full-screen fantasy landscape background -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Background>
                <ImageBrush ImageSource="{Binding backgroundImage}" Stretch="UniformToFill"/>
            </Border.Background>
        </Border>

        <!-- Semi-transparent dark overlay for readability -->
        <Border Background="#22000000"/>

        <!-- Layout -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.03*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.03*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0"/>
            </Grid.RowDefinitions>

            <!-- Header bar: Relics (left, clickable) | Run (center) | Levels Beaten (right) -->
            <Grid Grid.Row="1" VerticalAlignment="Top" Height="280">
                <!-- Dark wood gradient background matching GameHud style -->
                <Border CornerRadius="0,0,40,40">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#F02a1a0e" Offset="0"/>
                            <GradientStop Color="#FF0a0500" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <!-- Gold bottom border line -->
                    <Border BorderThickness="0,0,0,6" BorderBrush="#553B14" CornerRadius="0,0,40,40"/>
                </Border>

                <!-- Content: Three sections -->
                <Grid Margin="60,36,60,36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SECTION: Relics (clickable) with pulsing glow -->
                    <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                        <Grid.RenderTransform><ScaleTransform x:Name="RelicsScaleTransform" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Grid.Resources>
                            <Storyboard x:Key="RelicsPulseAnim" RepeatBehavior="Forever">
                                <!-- Breathing scale 1.0 → 1.06 → 1.0 over 1.8s -->
                                <DoubleAnimation Storyboard.TargetName="RelicsScaleTransform"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="RelicsScaleTransform"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <!-- Glow opacity pulse 0.0 → 1.0 → 0.0 over 1.8s -->
                                <DoubleAnimation Storyboard.TargetName="RelicsGlowBorder"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </Grid.Resources>
                        <!-- Conditionally play pulse animation only when relicPulseActive is true -->
                        <b:Interaction.Triggers>
                            <b:DataTrigger Binding="{Binding relicPulseActive}" Value="True">
                                <b:ControlStoryboardAction Storyboard="{StaticResource RelicsPulseAnim}" ControlStoryboardOption="Play"/>
                            </b:DataTrigger>
                            <b:DataTrigger Binding="{Binding relicPulseActive}" Value="False">
                                <b:ControlStoryboardAction Storyboard="{StaticResource RelicsPulseAnim}" ControlStoryboardOption="Stop"/>
                            </b:DataTrigger>
                        </b:Interaction.Triggers>

                        <!-- Outer glow border (pulsing golden shimmer behind the main border) -->
                        <Border x:Name="RelicsGlowBorder" Opacity="0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="Transparent"
                                BorderBrush="#AAf5c518"
                                BorderThickness="10"
                                CornerRadius="24"
                                Margin="-8,-8,-8,-8"/>

                        <!-- Main RELICS border -->
                        <Border Background="#CC1a1a2e"
                                BorderBrush="{StaticResource GoldBrush}"
                                BorderThickness="5"
                                CornerRadius="18">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseLeftButtonUp">
                                <b:InvokeCommandAction Command="{Binding events.relicCarouselTap}" CommandParameter="open"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <Grid>
                            <!-- Corner Ornaments (inside with 8px breathing room) -->
                            <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"/>
                            <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="11,11,0,0"/>
                            <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"/>
                            <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,11,0"/>
                            <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                            <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="11,0,0,11"/>
                            <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
                            <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,11,11"/>
                            <!-- Relics content -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="44,22,72,22">
                                <!-- Relic gem icon (faceted crystal artifact) -->
                                <Viewbox Width="96" Height="96" Margin="0,0,16,0">
                                    <Grid Width="24" Height="24">
                                        <!-- Crystal body (hexagonal gem shape) -->
                                        <Path Fill="#9b59b6" Data="M12 1 L7 4 L5 10 L7 18 L12 23 L17 18 L19 10 L17 4 Z"/>
                                        <!-- Inner facet highlights -->
                                        <Path Fill="#c39bd3" Data="M12 3 L9 5 L8 10 L12 14 L16 10 L15 5 Z" Opacity="0.7"/>
                                        <!-- Top sparkle/glow -->
                                        <Path Fill="#e8daef" Data="M12 2 L10 5 L12 6 L14 5 Z" Opacity="0.9"/>
                                        <!-- Bottom facet -->
                                        <Path Fill="#7d3c98" Data="M9 14 L12 22 L15 14 L12 16 Z" Opacity="0.6"/>

                                    </Grid>
                                </Viewbox>
                                <!-- RELICS label + count with outline (horizontal layout) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="RELICS" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="-2,0,0,0"/>
                                        <TextBlock Text="RELICS" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="2,0,0,0"/>
                                        <TextBlock Text="RELICS" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="0,-2,0,0"/>
                                        <TextBlock Text="RELICS" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="0,2,0,0"/>
                                        <TextBlock Text="RELICS" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                                    </Grid>
                                    <Grid VerticalAlignment="Center" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding relicCount, StringFormat=F0}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="-3,0,0,0"/>
                                        <TextBlock Text="{Binding relicCount, StringFormat=F0}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="3,0,0,0"/>
                                        <TextBlock Text="{Binding relicCount, StringFormat=F0}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="0,-3,0,0"/>
                                        <TextBlock Text="{Binding relicCount, StringFormat=F0}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding relicCount, StringFormat=F0}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>

                    <!-- CENTER SECTION: Run count -->
                    <Border Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#CC1a1a2e"
                            BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="5"
                            CornerRadius="18"
                            IsHitTestVisible="False">
                        <Grid>
                            <!-- Corner Ornaments (inside with 8px breathing room) -->
                            <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"/>
                            <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="11,11,0,0"/>
                            <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"/>
                            <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,11,0"/>
                            <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                            <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="11,0,0,11"/>
                            <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
                            <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,11,11"/>
                            <!-- Run label with outline -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,14,40,14">
                                <TextBlock Text="{Binding runLabel}" FontFamily="Anton" FontSize="80" FontWeight="Bold" Foreground="Black" Margin="-4,0,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding runLabel}" FontFamily="Anton" FontSize="80" FontWeight="Bold" Foreground="Black" Margin="4,0,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding runLabel}" FontFamily="Anton" FontSize="80" FontWeight="Bold" Foreground="Black" Margin="0,-4,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding runLabel}" FontFamily="Anton" FontSize="80" FontWeight="Bold" Foreground="Black" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding runLabel}" FontFamily="Anton" FontSize="80" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- RIGHT SECTION: Skull currency (metaprogression) with pulsing glow -->
                    <!-- CONVENTION: All clickable interactive elements in the overworld should have this
                         pulsing glow animation (breathing scale + gold border opacity pulse) to signal interactivity. -->
                    <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                        <Grid.RenderTransform><ScaleTransform x:Name="SkullScaleTransform" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Grid.Resources>
                            <Storyboard x:Key="SkullPulseAnim" RepeatBehavior="Forever">
                                <!-- Breathing scale 1.0 → 1.06 → 1.0 over 1.8s -->
                                <DoubleAnimation Storyboard.TargetName="SkullScaleTransform"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="SkullScaleTransform"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <!-- Glow opacity pulse 0.0 → 1.0 → 0.0 over 1.8s -->
                                <DoubleAnimation Storyboard.TargetName="SkullGlowBorder"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </Grid.Resources>
                        <!-- Auto-play pulse animation on load (skulls are always tappable) -->
                        <b:Interaction.Triggers>
                            <b:EventTrigger>
                                <b:ControlStoryboardAction Storyboard="{StaticResource SkullPulseAnim}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>

                        <!-- Outer glow border (pulsing golden shimmer behind the main border) -->
                        <Border x:Name="SkullGlowBorder" Opacity="0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="Transparent"
                                BorderBrush="#AAf5c518"
                                BorderThickness="10"
                                CornerRadius="24"
                                Margin="-8,-8,-8,-8"/>

                        <!-- Main SKULLS border -->
                        <Border Background="#CC1a1a2e"
                                BorderBrush="{StaticResource GoldBrush}"
                                BorderThickness="5"
                                CornerRadius="18">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="MouseLeftButtonUp">
                                    <b:InvokeCommandAction Command="{Binding events.skullSectionTap}" CommandParameter="open"/>
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                            <Grid>
                                <!-- Corner Ornaments -->
                                <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"/>
                                <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="11,11,0,0"/>
                                <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"/>
                                <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,11,0"/>
                                <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                                <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="11,0,0,11"/>
                                <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
                                <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,11,11"/>
                                <!-- Skull icon + count -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="44,22,44,22">
                                    <!-- Skull icon (SVG-style paths) -->
                                    <Viewbox Width="96" Height="96" Margin="0,0,16,0">
                                        <Grid Width="24" Height="24">
                                            <!-- Skull dome -->
                                            <Path Fill="#E8E8E8" Data="M12 2 C7 2 3 6 3 11 C3 14 4 16 6 17 L6 20 C6 21 7 22 8 22 L16 22 C17 22 18 21 18 20 L18 17 C20 16 21 14 21 11 C21 6 17 2 12 2 Z"/>
                                            <!-- Left eye socket -->
                                            <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                            <!-- Right eye socket -->
                                            <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,2"/>
                                            <!-- Nose -->
                                            <Path Fill="#1A1A2E" Data="M11 14 L12 16 L13 14 Z"/>
                                            <!-- Teeth -->
                                            <Path Fill="#1A1A2E" Data="M9 18 L9 20 M11 18 L11 20 M13 18 L13 20 M15 18 L15 20" StrokeThickness="0.8" Stroke="#1A1A2E"/>
                                        </Grid>
                                    </Viewbox>
                                    <!-- SKULLS label with outline -->
                                    <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="SKULLS" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="-2,0,0,0"/>
                                        <TextBlock Text="SKULLS" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="2,0,0,0"/>
                                        <TextBlock Text="SKULLS" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="0,-2,0,0"/>
                                        <TextBlock Text="SKULLS" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="0,2,0,0"/>
                                        <TextBlock Text="SKULLS" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                                    </Grid>
                                    <!-- Count with outline -->
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{Binding skullCount, StringFormat=F0}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="-3,0,0,0"/>
                                        <TextBlock Text="{Binding skullCount, StringFormat=F0}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="3,0,0,0"/>
                                        <TextBlock Text="{Binding skullCount, StringFormat=F0}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="0,-3,0,0"/>
                                        <TextBlock Text="{Binding skullCount, StringFormat=F0}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding skullCount, StringFormat=F0}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Winding path scroll area -->
            <ScrollViewer Grid.Row="3"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <Canvas Width="900" Height="{Binding canvasHeight}">
                    <!-- COBBLESTONE PATH: Chunky multi-layer path with texture stripes -->
                    <!-- Layer 1: Outermost dark edge shadow (depth illusion) -->
                    <Path Data="{Binding pathData}" Stroke="#FF1A0E05" StrokeThickness="90" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    <!-- Layer 2: Dark stone border -->
                    <Path Data="{Binding pathData}" Stroke="{StaticResource PathStrokeOuterBrush}" StrokeThickness="82" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    <!-- Layer 3: Main warm stone body (thick fill) -->
                    <Path Data="{Binding pathData}" Stroke="{StaticResource PathStrokeBrush}" StrokeThickness="68" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    <!-- Layer 4: Cobblestone stripe - center groove (dark mortar line) -->
                    <Path Data="{Binding pathData}" Stroke="#FF6B4F1A" StrokeThickness="4" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeLineJoin="Round" StrokeDashArray="6 3"/>
                    <!-- Layer 5: Cobblestone stripe - left groove -->
                    <Path Data="{Binding pathData}" Stroke="#FF7A5A20" StrokeThickness="3" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeLineJoin="Round" StrokeDashArray="4 5" StrokeDashOffset="2">
                        <Path.RenderTransform><TranslateTransform X="-12"/></Path.RenderTransform>
                    </Path>
                    <!-- Layer 6: Cobblestone stripe - right groove -->
                    <Path Data="{Binding pathData}" Stroke="#FF7A5A20" StrokeThickness="3" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeLineJoin="Round" StrokeDashArray="4 5" StrokeDashOffset="4">
                        <Path.RenderTransform><TranslateTransform X="12"/></Path.RenderTransform>
                    </Path>
                    <!-- Layer 7: Cobblestone stripe - far left mortar -->
                    <Path Data="{Binding pathData}" Stroke="#FF8B6828" StrokeThickness="2" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeLineJoin="Round" StrokeDashArray="3 4" StrokeDashOffset="1">
                        <Path.RenderTransform><TranslateTransform X="-24"/></Path.RenderTransform>
                    </Path>
                    <!-- Layer 8: Cobblestone stripe - far right mortar -->
                    <Path Data="{Binding pathData}" Stroke="#FF8B6828" StrokeThickness="2" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeLineJoin="Round" StrokeDashArray="3 4" StrokeDashOffset="3">
                        <Path.RenderTransform><TranslateTransform X="24"/></Path.RenderTransform>
                    </Path>
                    <!-- Layer 9: Highlight edge (top bevel for volume) -->
                    <Path Data="{Binding pathData}" Stroke="#44FFFFFF" StrokeThickness="68" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.12"/>
                    <!-- Layer 10: Inner highlight line (gives raised center feel) -->
                    <Path Data="{Binding pathData}" Stroke="#33FFE8B0" StrokeThickness="20" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.3"/>
                    <ItemsControl ItemsSource="{Binding nodes}" ItemsPanel="{StaticResource CanvasPanel}" ItemContainerStyle="{StaticResource NodeContainerStyle}" ItemTemplate="{StaticResource LevelNodeTemplate}" Canvas.ZIndex="1"/>
                </Canvas>
            </ScrollViewer>

            <!-- Bottom header bar: Next Level indicator (flush against bottom edge) -->
            <Grid Grid.Row="5" VerticalAlignment="Bottom" Height="220">
                <!-- Dark wood gradient background (flipped: darker at top) with top gold border -->
                <Border CornerRadius="40,40,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#FF0a0500" Offset="0"/>
                            <GradientStop Color="#F02a1a0e" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <!-- Gold top border line -->
                    <Border BorderThickness="0,6,0,0" BorderBrush="#553B14" CornerRadius="40,40,0,0"/>
                </Border>

                <!-- Corner ornament dots -->
                <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,24,0,0"/>
                <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="27,27,0,0"/>
                <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"/>
                <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,27,27,0"/>
                <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,24"/>
                <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="27,0,0,27"/>
                <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"/>
                <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,27,27"/>

                <!-- Centered Next Level text with crossed swords icon -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Map icon (folded treasure map) -->
                    <Viewbox Width="100" Height="100" Margin="0,0,20,0" VerticalAlignment="Center">
                        <Grid Width="25" Height="25">
                            <!-- Map body (folded parchment shape) -->
                            <Path Data="M3 4 L3 20 C3 20.5 3.5 21 4 21 L20 21 C20.5 21 21 20.5 21 20 L21 4 C21 3.5 20.5 3 20 3 L4 3 C3.5 3 3 3.5 3 4 Z" Fill="#FFFF5B00"/>
                            <!-- Fold lines (vertical creases) -->
                            <Path StrokeThickness="0.8" Data="M9 3 L9 21">
                                <Path.Stroke>
                                    <SolidColorBrush Color="#FF660000" Opacity="0.383"/>
                                </Path.Stroke>
                            </Path>
                            <Path Opacity="0.38" Stroke="#FF660000" StrokeThickness="0.8" Data="M15 3 L15 21"/>
                            <!-- Dotted trail path (treasure route) -->
                            <Path Stroke="#1A1A2E" StrokeThickness="1.2" StrokeDashArray="1.5 1" Data="M6 17 L8 14 L11 15 L13 11 L16 13 L18 9"/>
                            <!-- X marks the spot -->
                            <Path Stroke="#1A1A2E" StrokeThickness="1.5" Data="M17 7 L19 9 M19 7 L17 9"/>
                            <!-- Small landmark dot -->
                            <Ellipse Width="2" Height="2" Fill="#1A1A2E" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,16,0,0"/>
                        </Grid>
                    </Viewbox>
                    <!-- Text with outline -->
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="{Binding levelsBeatenText}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="-3,0,0,0"/>
                        <TextBlock Text="{Binding levelsBeatenText}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="3,0,0,0"/>
                        <TextBlock Text="{Binding levelsBeatenText}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,-3,0,0"/>
                        <TextBlock Text="{Binding levelsBeatenText}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding levelsBeatenText}" FontFamily="Anton" FontSize="72" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Biome Navigation Arrow - LEFT (previous biome, vertically centered) -->
        <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0,0,0"
              RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
            <Grid.Visibility>
                <Binding Path="biomeArrowLeftVisible">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter/>
                    </Binding.Converter>
                </Binding>
            </Grid.Visibility>
            <Grid.RenderTransform><ScaleTransform x:Name="BiomeArrowLeftScaleTransform" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
            <Grid.Resources>
                <Storyboard x:Key="BiomeArrowLeftPulseAnim" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="BiomeArrowLeftScaleTransform"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="1.0" To="1.08" Duration="0:0:0.9" AutoReverse="True">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="BiomeArrowLeftScaleTransform"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="1.0" To="1.08" Duration="0:0:0.9" AutoReverse="True">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="BiomeArrowLeftGlowBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <b:Interaction.Triggers>
                <b:EventTrigger>
                    <b:ControlStoryboardAction Storyboard="{StaticResource BiomeArrowLeftPulseAnim}"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>

            <!-- Outer glow border (color bound to destination biome) -->
            <Border x:Name="BiomeArrowLeftGlowBorder" Opacity="0"
                    Background="Transparent"
                    BorderBrush="{Binding biomeArrowLeftGlowColor}"
                    BorderThickness="10"
                    CornerRadius="24"
                    Margin="-8,-8,-8,-8"/>

            <!-- Main arrow button (border color bound to destination biome) -->
            <Border Background="#FF1a1a2e"
                    BorderBrush="{Binding biomeArrowLeftColor}"
                    BorderThickness="5"
                    CornerRadius="18"
                    Padding="24,40,24,40">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseLeftButtonUp">
                        <b:InvokeCommandAction Command="{Binding events.biomeArrowTap}" CommandParameter="prev"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- GRASS icon (leaf) -->
                    <Viewbox Width="96" Height="96" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding biomeArrowLeftType}" Value="grass">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <Grid Width="24" Height="24">
                            <Path Fill="{Binding biomeArrowLeftColor}"
                                  Data="M17 8 C8 10 5.9 16.09 3.82 21.15 L5.1 22 C6.1 19.5 7.5 17 9 15 C9 18.5 10 22 12 22 C14 22 15 19.5 15 17 C15 14.5 14 13 12 12 C14 12 17 10 18 8 C19 6 19.5 4 20 2 C18 4 16 6 15 7 C15 7 17 6 17 8 Z"/>
                        </Grid>
                    </Viewbox>
                    <!-- SNOW icon (snowflake) -->
                    <Viewbox Width="96" Height="96" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding biomeArrowLeftType}" Value="snow">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <Grid Width="24" Height="24">
                            <Path Stroke="{Binding biomeArrowLeftColor}" StrokeThickness="1.8"
                                  Data="M12 2 L12 22 M2 12 L22 12 M5 5 L19 19 M19 5 L5 19"/>
                            <Path Stroke="{Binding biomeArrowLeftColor}" StrokeThickness="1.2"
                                  Data="M12 4 L10 6 M12 4 L14 6 M12 20 L10 18 M12 20 L14 18 M4 12 L6 10 M4 12 L6 14 M20 12 L18 10 M20 12 L18 14"/>
                        </Grid>
                    </Viewbox>
                    <!-- VOLCANO icon (flame) -->
                    <Viewbox Width="96" Height="96" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding biomeArrowLeftType}" Value="volcano">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <Grid Width="24" Height="24">
                            <Path Fill="{Binding biomeArrowLeftColor}"
                                  Data="M12 2 C12 2 8 7 8 12 C8 14 9 16 10 17 C9 15 9 13 10 11 C10 11 11 14 12 15 C13 14 14 11 14 11 C15 13 15 15 14 17 C15 16 16 14 16 12 C16 7 12 2 12 2 Z"/>
                        </Grid>
                    </Viewbox>
                    <!-- Biome label with outline (text color bound to destination biome) -->
                    <Grid HorizontalAlignment="Center">
                        <TextBlock Text="{Binding biomeArrowLeftLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="-2,0,0,0"/>
                        <TextBlock Text="{Binding biomeArrowLeftLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="2,0,0,0"/>
                        <TextBlock Text="{Binding biomeArrowLeftLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                        <TextBlock Text="{Binding biomeArrowLeftLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding biomeArrowLeftLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="{Binding biomeArrowLeftColor}" HorizontalAlignment="Center"/>
                    </Grid>
                    <!-- Arrow pointing left (stroke color bound to destination biome) -->
                    <Viewbox Width="72" Height="72" Margin="0,8,0,0" HorizontalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <Path Stroke="{Binding biomeArrowLeftColor}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M16 12 L8 12 M12 8 L8 12 L12 16"/>
                        </Grid>
                    </Viewbox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Biome Navigation Arrow - RIGHT (next biome, vertically centered) -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0"
              RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
            <Grid.Visibility>
                <Binding Path="biomeArrowVisible">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter/>
                    </Binding.Converter>
                </Binding>
            </Grid.Visibility>
            <Grid.RenderTransform><ScaleTransform x:Name="BiomeArrowScaleTransform" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
            <Grid.Resources>
                <Storyboard x:Key="BiomeArrowPulseAnim" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="BiomeArrowScaleTransform"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="1.0" To="1.08" Duration="0:0:0.9" AutoReverse="True">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="BiomeArrowScaleTransform"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="1.0" To="1.08" Duration="0:0:0.9" AutoReverse="True">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="BiomeArrowGlowBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <b:Interaction.Triggers>
                <b:EventTrigger>
                    <b:ControlStoryboardAction Storyboard="{StaticResource BiomeArrowPulseAnim}"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>

            <!-- Outer glow border (color bound to destination biome) -->
            <Border x:Name="BiomeArrowGlowBorder" Opacity="0"
                    Background="Transparent"
                    BorderBrush="{Binding biomeArrowRightGlowColor}"
                    BorderThickness="10"
                    CornerRadius="24"
                    Margin="-8,-8,-8,-8"/>

            <!-- Main arrow button (border color bound to destination biome) -->
            <Border Background="#FF1a1a2e"
                    BorderBrush="{Binding biomeArrowRightColor}"
                    BorderThickness="5"
                    CornerRadius="18"
                    Padding="24,40,24,40">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseLeftButtonUp">
                        <b:InvokeCommandAction Command="{Binding events.biomeArrowTap}" CommandParameter="next"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- GRASS icon (leaf) -->
                    <Viewbox Width="96" Height="96" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding biomeArrowRightType}" Value="grass">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <Grid Width="24" Height="24">
                            <Path Fill="{Binding biomeArrowRightColor}"
                                  Data="M17 8 C8 10 5.9 16.09 3.82 21.15 L5.1 22 C6.1 19.5 7.5 17 9 15 C9 18.5 10 22 12 22 C14 22 15 19.5 15 17 C15 14.5 14 13 12 12 C14 12 17 10 18 8 C19 6 19.5 4 20 2 C18 4 16 6 15 7 C15 7 17 6 17 8 Z"/>
                        </Grid>
                    </Viewbox>
                    <!-- SNOW icon (snowflake) -->
                    <Viewbox Width="96" Height="96" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding biomeArrowRightType}" Value="snow">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <Grid Width="24" Height="24">
                            <Path Stroke="{Binding biomeArrowRightColor}" StrokeThickness="1.8"
                                  Data="M12 2 L12 22 M2 12 L22 12 M5 5 L19 19 M19 5 L5 19"/>
                            <Path Stroke="{Binding biomeArrowRightColor}" StrokeThickness="1.2"
                                  Data="M12 4 L10 6 M12 4 L14 6 M12 20 L10 18 M12 20 L14 18 M4 12 L6 10 M4 12 L6 14 M20 12 L18 10 M20 12 L18 14"/>
                        </Grid>
                    </Viewbox>
                    <!-- VOLCANO icon (flame) -->
                    <Viewbox Width="96" Height="96" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding biomeArrowRightType}" Value="volcano">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <Grid Width="24" Height="24">
                            <Path Fill="{Binding biomeArrowRightColor}"
                                  Data="M12 2 C12 2 8 7 8 12 C8 14 9 16 10 17 C9 15 9 13 10 11 C10 11 11 14 12 15 C13 14 14 11 14 11 C15 13 15 15 14 17 C15 16 16 14 16 12 C16 7 12 2 12 2 Z"/>
                        </Grid>
                    </Viewbox>
                    <!-- Biome label with outline (text color bound to destination biome) -->
                    <Grid HorizontalAlignment="Center">
                        <TextBlock Text="{Binding biomeArrowLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="-2,0,0,0"/>
                        <TextBlock Text="{Binding biomeArrowLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="2,0,0,0"/>
                        <TextBlock Text="{Binding biomeArrowLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                        <TextBlock Text="{Binding biomeArrowLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding biomeArrowLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="{Binding biomeArrowRightColor}" HorizontalAlignment="Center"/>
                    </Grid>
                    <!-- Arrow pointing right (stroke color bound to destination biome) -->
                    <Viewbox Width="72" Height="72" Margin="0,8,0,0" HorizontalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <Path Stroke="{Binding biomeArrowRightColor}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M8 12 L16 12 M12 8 L16 12 L12 16"/>
                        </Grid>
                    </Viewbox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Relic carousel overlay (fullscreen) -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.Visibility>
                <Binding Path="carouselVisible">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter/>
                    </Binding.Converter>
                </Binding>
            </Grid.Visibility>

            <Border Background="#CC000000">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseLeftButtonUp">
                        <b:InvokeCommandAction Command="{Binding events.relicCarouselTap}" CommandParameter="close"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </Border>

            <!-- Vertical layout: Cards -> Dots -> Title — pushed to upper portion of screen -->
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.08*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0.02*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0.02*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0.08*"/>
                </Grid.RowDefinitions>

                <!-- Cards area -->
                <Canvas Grid.Row="1" HorizontalAlignment="Center" Width="1800" Height="1800">
                    <ItemsControl ItemsSource="{Binding carouselCards}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding cardLeft}"/>
                                <Setter Property="Canvas.Top" Value="{Binding cardTop}"/>
                                <Setter Property="Canvas.ZIndex" Value="{Binding cardZIndex}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding cardWidth}" Height="{Binding cardHeight}" CornerRadius="24" BorderThickness="5" BorderBrush="{StaticResource GoldBrush}" Opacity="{Binding cardOpacity}" RenderTransformOrigin="0.5,0.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF2A1A0A" Offset="0"/>
                                            <GradientStop Color="#FF1A1008" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding cardScaleX}" ScaleY="{Binding cardScaleY}"/>
                                    </Border.RenderTransform>
                                    <Grid Margin="32">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Width="700" Height="700" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Background><ImageBrush ImageSource="{Binding icon}" Stretch="Uniform"/></Border.Background>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding relicName}" FontFamily="Almendra" FontSize="96" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextAlignment="Center" TextWrapping="Wrap" Margin="12,12,12,4"/>
                                        <TextBlock Grid.Row="2" Text="{Binding relicDescription}" FontFamily="Almendra" FontSize="68" Foreground="{StaticResource ParchmentBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" TextWrapping="Wrap" TextAlignment="Center" Margin="12,4,12,16"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>

                <!-- Dot indicators - just below cards -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding carouselDots}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="{Binding dotSize}" Height="{Binding dotSize}" Margin="12,0" Fill="{Binding dotColor}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Title "YOUR RELICS" - below dots, styled panel -->
                <Border Grid.Row="5" HorizontalAlignment="Center"
                        Background="#CC1a1a2e"
                        BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="5"
                        CornerRadius="18"
                        Padding="48,14,48,14">
                    <Grid>
                        <!-- Corner Ornaments -->
                        <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"/>
                        <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="11,11,0,0"/>
                        <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"/>
                        <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,11,0"/>
                        <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                        <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="11,0,0,11"/>
                        <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
                        <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,11,11"/>
                        <!-- Text with outline -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,8,32,8">
                            <TextBlock Text="YOUR RELICS" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="Black" Margin="-4,0,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="YOUR RELICS" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="Black" Margin="4,0,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="YOUR RELICS" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="Black" Margin="0,-4,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="YOUR RELICS" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="Black" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="YOUR RELICS" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>


            </Grid>

            <!-- Swipe detection grid (overlays the full carousel area for reliable swipe detection) -->
            <!-- 15 zones for highly responsive swipe detection -->
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d0"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u0"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="1" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d1"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u1"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="2" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d2"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u2"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="3" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d3"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u3"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="4" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d4"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u4"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="5" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d5"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u5"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="6" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d6"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u6"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="7" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d7"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u7"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="8" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d8"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u8"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="9" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d9"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u9"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="10" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d10"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u10"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="11" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d11"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u11"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="12" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d12"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u12"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="13" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d13"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u13"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
                <Border Grid.Column="14" Background="Transparent">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseLeftButtonDown"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="d14"/></b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeftButtonUp"><b:InvokeCommandAction Command="{Binding events.relicCarouselSwipe}" CommandParameter="u14"/></b:EventTrigger>
                    </b:Interaction.Triggers>
                </Border>
            </Grid>

            <!-- Close X button - renders ABOVE swipe grid, guaranteed visible and clickable -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,120"
                    CornerRadius="52" Background="#FF1a1a2e" BorderBrush="{StaticResource GoldBrush}" BorderThickness="6" Width="120" Height="120" Panel.ZIndex="200">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseLeftButtonUp">
                        <b:InvokeCommandAction Command="{Binding events.relicCarouselTap}" CommandParameter="close"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <TextBlock Text="X" FontFamily="Anton" FontSize="64" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Page>
