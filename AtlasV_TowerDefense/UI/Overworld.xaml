                                <Path Fill="{Binding biomeArrowRightColor}"
                                      Data="M17 8 C8 10 5.9 16.09 3.82 21.15 L5.1 22 C6.1 19.5 7.5 17 9 15 C9 18.5 10 22 12 22 C14 22 15 19.5 15 17 C15 14.5 14 13 12 12 C14 12 17 10 18 8 C19 6 19.5 4 20 2 C18 4 16 6 15 7 C15 7 17 6 17 8 Z"/>
                            </Grid>
                        </Viewbox>
                        <Viewbox Width="96" Height="96" Margin="0,0,0,12" HorizontalAlignment="Center">
