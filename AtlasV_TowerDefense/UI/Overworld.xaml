                            <Grid Width="24" Height="24">
                                <Path Fill="#AAAAAA" Data="M18 10 L16 10 L16 7 C16 4.8 14.2 3 12 3 C9.8 3 8 4.8 8 7 L8 10 L6 10 C5 10 4 11 4 12 L4 20 C4 21 5 22 6 22 L18 22 C19 22 20 21 20 20 L20 12 C20 11 19 10 18 10 Z M12 17 C10.9 17 10 16.1 10 15 C10 13.9 10.9 13 12 13 C13.1 13 14 13.9 14 15 C14 16.1 13.1 17 12 17 Z M14 10 L10 10 L10 7 C10 5.9 10.9 5 12 5 C13.1 5 14 5.9 14 7 L14 10 Z"/>
                            </Grid>
                        </Viewbox>
                        <!-- Biome label (gray) -->
                        <Grid HorizontalAlignment="Center">
                            <TextBlock Text="{Binding biomeArrowLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="-2,0,0,0"/>
                            <TextBlock Text="{Binding biomeArrowLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="2,0,0,0"/>
                            <TextBlock Text="{Binding biomeArrowLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            <TextBlock Text="{Binding biomeArrowLabel}" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,2,0,0"/>
