                                <Path Stroke="{Binding biomeArrowRightColor}" StrokeThickness="1.2"
                                      Data="M12 4 L10 6 M12 4 L14 6 M12 20 L10 18 M12 20 L14 18 M4 12 L6 10 M4 12 L6 14 M20 12 L18 10 M20 12 L18 14"/>
                            </Grid>
                        </Viewbox>
                        <Viewbox Width="96" Height="96" Margin="0,0,0,12" HorizontalAlignment="Center">
