                                <Path Fill="#FDBA12" Data="M12 3 L2 12 L5 12 L5 21 L10 21 L10 15 L14 15 L14 21 L19 21 L19 12 L22 12 Z"/>
                            </Grid>
                        </Viewbox>
                        <!-- TITLE label with outline -->
                        <Grid HorizontalAlignment="Center">
                            <TextBlock Text="TITLE" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="-2,0,0,0"/>
                            <TextBlock Text="TITLE" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="2,0,0,0"/>
                            <TextBlock Text="TITLE" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            <TextBlock Text="TITLE" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="TITLE" FontFamily="Anton" FontSize="48" FontWeight="Bold" Foreground="#FDBA12" HorizontalAlignment="Center"/>
