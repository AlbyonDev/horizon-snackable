                                        <TextBlock Text="SKILL TREE" FontFamily="Anton" FontSize="64" FontWeight="Bold" Foreground="Black" Margin="-2,0,0,0"/>
                                        <TextBlock Text="SKILL TREE" FontFamily="Anton" FontSize="64" FontWeight="Bold" Foreground="Black" Margin="2,0,0,0"/>
                                        <TextBlock Text="SKILL TREE" FontFamily="Anton" FontSize="64" FontWeight="Bold" Foreground="Black" Margin="0,-2,0,0"/>
                                        <TextBlock Text="SKILL TREE" FontFamily="Anton" FontSize="64" FontWeight="Bold" Foreground="Black" Margin="0,2,0,0"/>
