                                <TextBlock Text="{Binding runLabel}" FontFamily="Anton" FontSize="64" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,-3,0,0"/>
                                <TextBlock Text="{Binding runLabel}" FontFamily="Anton" FontSize="64" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding runLabel}" FontFamily="Anton" FontSize="64" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
