                                        <TextBlock Text="{Binding relicCount, StringFormat=F0}" FontFamily="Anton" FontSize="56" FontWeight="Bold" Foreground="Black" Margin="2,0,0,0"/>
                                        <TextBlock Text="{Binding relicCount, StringFormat=F0}" FontFamily="Anton" FontSize="56" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}"/>
                                    </Grid>
                                </StackPanel>
