<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d">

    <Page.Resources>
        <!-- Fantasy adventure map colors -->
        <SolidColorBrush x:Key="GoldBrush" Color="#FFf5c518"/>
        <SolidColorBrush x:Key="TextLightBrush" Color="#FFF5E6C8"/>
        <SolidColorBrush x:Key="ParchmentBrush" Color="#FFF5E6C8"/>
        <SolidColorBrush x:Key="DarkStoneBrush" Color="#FF2A1A0A"/>
        <!-- Path stroke: warm stone tan for the winding trail -->
        <SolidColorBrush x:Key="PathStrokeBrush" Color="#FFC4A44A"/>
        <SolidColorBrush x:Key="PathStrokeOuterBrush" Color="#FF9A7B30"/>

        <!-- Canvas panel for absolute positioning -->
        <ItemsPanelTemplate x:Key="CanvasPanel">
            <Canvas/>
        </ItemsPanelTemplate>

        <!-- Node container style: positions each node on the canvas -->
        <Style x:Key="NodeContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding posX}"/>
            <Setter Property="Canvas.Top" Value="{Binding posY}"/>
        </Style>

        <!-- Vertical panel for relic icons column (unused, kept for reference) -->
        <ItemsPanelTemplate x:Key="VerticalRelicPanel">
            <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>

        <!-- Level Node template with state-driven sprites -->
        <DataTemplate x:Key="LevelNodeTemplate">
            <Grid Width="{Binding nodeSize}" Height="{Binding nodeSize}" ClipToBounds="False">
                <Grid.Resources>
                    <!-- Looping breathing scale for open node sprites: 1.0 → 1.18 → 1.0 over 1.6s -->
                    <Storyboard x:Key="NodeBreathingAnim" RepeatBehavior="Forever">
                        <!-- CombatOpenSprite ScaleX -->
                        <DoubleAnimation Storyboard.TargetName="CombatOpenSprite"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         From="1.0" To="1.18" Duration="0:0:0.8" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <!-- CombatOpenSprite ScaleY -->
                        <DoubleAnimation Storyboard.TargetName="CombatOpenSprite"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         From="1.0" To="1.18" Duration="0:0:0.8" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <!-- BossOpenSprite ScaleX -->
                        <DoubleAnimation Storyboard.TargetName="BossOpenSprite"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         From="1.0" To="1.18" Duration="0:0:0.8" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <!-- BossOpenSprite ScaleY -->
                        <DoubleAnimation Storyboard.TargetName="BossOpenSprite"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         From="1.0" To="1.18" Duration="0:0:0.8" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <!-- MinigameOpenSprite ScaleX -->
                        <DoubleAnimation Storyboard.TargetName="MinigameOpenSprite"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         From="1.0" To="1.18" Duration="0:0:0.8" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <!-- MinigameOpenSprite ScaleY -->
                        <DoubleAnimation Storyboard.TargetName="MinigameOpenSprite"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         From="1.0" To="1.18" Duration="0:0:0.8" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Grid.Resources>

                <!-- Auto-play breathing scale animation on load -->
                <b:Interaction.Triggers>
                    <b:EventTrigger>
                        <b:ControlStoryboardAction Storyboard="{DynamicResource NodeBreathingAnim}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>


                <Grid Width="{Binding nodeSize}" Height="{Binding nodeSize}">
                <!-- Tap handler -->
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseLeftButtonUp">
                        <b:InvokeCommandAction Command="{Binding DataContext.events.levelTap, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding levelIndex}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>

                <!-- === COMBAT NODE SPRITES (nodeType=combat) === -->
                <Image Source="sprites/overworld_node_combat.png" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="combat"/>
                                        <Condition Binding="{Binding nodeState}" Value="beaten"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image x:Name="CombatOpenSprite" Source="sprites/overworld_node_combat_open.png" Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Image.RenderTransform>
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="combat"/>
                                        <Condition Binding="{Binding nodeState}" Value="open"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image Source="sprites/overworld_node_combat_locked.png" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="combat"/>
                                        <Condition Binding="{Binding nodeState}" Value="locked"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <!-- === BOSS NODE SPRITES (nodeType=boss) === -->
                <Image Source="sprites/overworld_node_boss.png" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="boss"/>
                                        <Condition Binding="{Binding nodeState}" Value="beaten"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image x:Name="BossOpenSprite" Source="sprites/overworld_node_boss_open.png" Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Image.RenderTransform>
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="boss"/>
                                        <Condition Binding="{Binding nodeState}" Value="open"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image Source="sprites/overworld_node_boss_locked.png" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="boss"/>
                                        <Condition Binding="{Binding nodeState}" Value="locked"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <!-- === MINIGAME NODE SPRITES (nodeType=minigame) === -->
                <Image Source="sprites/overworld_node_minigame.png" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="minigame"/>
                                        <Condition Binding="{Binding nodeState}" Value="beaten"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image x:Name="MinigameOpenSprite" Source="sprites/overworld_node_minigame_open.png" Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Image.RenderTransform>
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="minigame"/>
                                        <Condition Binding="{Binding nodeState}" Value="open"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image Source="sprites/overworld_node_minigame_locked.png" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding nodeType}" Value="minigame"/>
                                        <Condition Binding="{Binding nodeState}" Value="locked"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                </Grid>

                <!-- Boss modifier label (shown to the right of the node for boss type only) -->
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BossModScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform X="{Binding modifierOffsetX}" Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding nodeType}" Value="boss">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.Resources>
                        <!-- Pulsing animation matching SkullRewardPulseAnim -->
                        <Storyboard x:Key="BossModPulseAnim" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="BossModScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             From="1.0" To="1.08" Duration="0:0:0.8" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BossModScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             From="1.0" To="1.08" Duration="0:0:0.8" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BossModGlow"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.2" To="1.0" Duration="0:0:0.8" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Grid.Resources>
                    <b:Interaction.Triggers>
                        <b:EventTrigger>
                            <b:ControlStoryboardAction Storyboard="{DynamicResource BossModPulseAnim}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>

                    <!-- Outer glow (pulsing gold shimmer) -->
                    <Border x:Name="BossModGlow" Opacity="0.2"
                            Background="Transparent"
                            BorderBrush="#CCf5c518"
                            BorderThickness="6"
                            CornerRadius="16"
                            Margin="-4,-4,-4,-4"/>

                    <Border CornerRadius="12" Padding="28,16" BorderThickness="4"
                            Width="420"
                            BorderBrush="{StaticResource GoldBrush}" Background="#F00d0d1a">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseLeftButtonUp">
                                <b:InvokeCommandAction Command="{Binding DataContext.events.bossInfoTap, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding levelIndex}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <StackPanel>
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="BOSS MODIFIER" FontSize="38" FontWeight="Bold"
                                           FontFamily="Anton" Foreground="#FF1A1A0A"
                                           HorizontalAlignment="Center" Margin="-2,0,0,0"/>
                                <TextBlock Text="BOSS MODIFIER" FontSize="38" FontWeight="Bold"
                                           FontFamily="Anton" Foreground="#FF1A1A0A"
                                           HorizontalAlignment="Center" Margin="2,0,0,0"/>
                                <TextBlock Text="BOSS MODIFIER" FontSize="38" FontWeight="Bold"
                                           FontFamily="Anton" Foreground="#FF1A1A0A"
                                           HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                <TextBlock Text="BOSS MODIFIER" FontSize="38" FontWeight="Bold"
                                           FontFamily="Anton" Foreground="#FF1A1A0A"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="BOSS MODIFIER" FontSize="38" FontWeight="Bold"
                                           FontFamily="Anton" Foreground="{StaticResource GoldBrush}"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid HorizontalAlignment="Center" MaxWidth="360">
                                <TextBlock Text="{Binding modifierLabel}" FontSize="50" FontWeight="Bold"
                                           FontFamily="Anton" Foreground="#FF1A1A0A"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="-2,0,0,0"/>
                                <TextBlock Text="{Binding modifierLabel}" FontSize="50" FontWeight="Bold"
                                           FontFamily="Anton" Foreground="#FF1A1A0A"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="2,0,0,0"/>
                                <TextBlock Text="{Binding modifierLabel}" FontSize="50" FontWeight="Bold"
                                           FontFamily="Anton" Foreground="#FF1A1A0A"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,-2,0,0"/>
                                <TextBlock Text="{Binding modifierLabel}" FontSize="50" FontWeight="Bold"
                                           FontFamily="Anton" Foreground="#FF1A1A0A"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding modifierLabel}" FontSize="50" FontWeight="Bold"
                                           FontFamily="Anton" Foreground="{StaticResource GoldBrush}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Skull reward badge (animated, shown on boss nodes not yet beaten) -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding showSkullReward}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SkullRewardScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="SkullRewardTranslate" Y="100"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.Resources>
                        <!-- Floating + pulsing animation: scale breathe + vertical bob -->
                        <Storyboard x:Key="SkullRewardPulseAnim" RepeatBehavior="Forever">
                            <!-- Scale pulse 1.0 -> 1.15 -> 1.0 -->
                            <DoubleAnimation Storyboard.TargetName="SkullRewardScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             From="1.0" To="1.15" Duration="0:0:0.7" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SkullRewardScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             From="1.0" To="1.15" Duration="0:0:0.7" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- Vertical bob: float up and down -->
                            <DoubleAnimation Storyboard.TargetName="SkullRewardTranslate"
                                             Storyboard.TargetProperty="Y"
                                             From="100" To="88" Duration="0:0:0.9" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- Glow border opacity pulse -->
                            <DoubleAnimation Storyboard.TargetName="SkullRewardGlow"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.3" To="1.0" Duration="0:0:0.7" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Grid.Resources>
                    <b:Interaction.Triggers>
                        <b:EventTrigger>
                            <b:ControlStoryboardAction Storyboard="{DynamicResource SkullRewardPulseAnim}"/>
                        </b:EventTrigger>
                        <!-- Tap handler to open boss info popup -->
                        <b:EventTrigger EventName="MouseLeftButtonUp">
                            <b:InvokeCommandAction Command="{Binding DataContext.events.bossInfoTap, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding levelIndex}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>

                    <!-- Outer glow (pulsing gold shimmer) -->
                    <Border x:Name="SkullRewardGlow" Opacity="0.3"
                            Background="Transparent"
                            BorderBrush="#CCf5c518"
                            BorderThickness="8"
                            CornerRadius="32"
                            Margin="-6,-6,-6,-6"/>

                    <!-- Badge body -->
                    <Border Background="#F01a0a2e"
                            BorderBrush="#FFf5c518"
                            BorderThickness="5"
                            CornerRadius="26"
                            Padding="24,14,28,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Skull icon (inline SVG) -->
                            <Viewbox Width="64" Height="64" Margin="0,0,10,0">
                                <Grid Width="24" Height="24">
                                    <Path Fill="#E8E8E8" Data="M12 2 C7 2 3 6 3 11 C3 14 4 16 6 17 L6 20 C6 21 7 22 8 22 L16 22 C17 22 18 21 18 20 L18 17 C20 16 21 14 21 11 C21 6 17 2 12 2 Z"/>
                                    <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                    <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,2"/>
                                    <Path Fill="#1A1A2E" Data="M11 14 L12 16 L13 14 Z"/>
                                    <Path Fill="#1A1A2E" Data="M9 18 L9 20 M11 18 L11 20 M13 18 L13 20 M15 18 L15 20" StrokeThickness="0.8" Stroke="#1A1A2E"/>
                                </Grid>
                            </Viewbox>
                            <!-- Reward text with outline -->
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="{Binding skullRewardText}" FontFamily="Anton" FontSize="56" FontWeight="Bold" Foreground="Black" Margin="-2,0,0,0"/>
                                <TextBlock Text="{Binding skullRewardText}" FontFamily="Anton" FontSize="56" FontWeight="Bold" Foreground="Black" Margin="2,0,0,0"/>
                                <TextBlock Text="{Binding skullRewardText}" FontFamily="Anton" FontSize="56" FontWeight="Bold" Foreground="Black" Margin="0,-2,0,0"/>
                                <TextBlock Text="{Binding skullRewardText}" FontFamily="Anton" FontSize="56" FontWeight="Bold" Foreground="Black" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding skullRewardText}" FontFamily="Anton" FontSize="56" FontWeight="Bold" Foreground="#FFf5c518"/>
                            </Grid>
                            <!-- Teal x2 multiplier label (visible when skull earn rate > 1) -->
                            <Grid VerticalAlignment="Center" Margin="8,0,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding showSkullMultiplier}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Text="x2" FontFamily="Anton" FontSize="52" FontWeight="Bold" Foreground="Black" Margin="-2,0,0,0"/>
                                <TextBlock Text="x2" FontFamily="Anton" FontSize="52" FontWeight="Bold" Foreground="Black" Margin="2,0,0,0"/>
                                <TextBlock Text="x2" FontFamily="Anton" FontSize="52" FontWeight="Bold" Foreground="Black" Margin="0,-2,0,0"/>
                                <TextBlock Text="x2" FontFamily="Anton" FontSize="52" FontWeight="Bold" Foreground="Black" Margin="0,2,0,0"/>
                                <TextBlock Text="x2" FontFamily="Anton" FontSize="52" FontWeight="Bold" Foreground="#FF00BCD4"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>


            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- Main Container -->
    <Grid>
        <Grid.Visibility>
            <Binding Path="visible">
                <Binding.Converter>
                    <BooleanToVisibilityConverter/>
                </Binding.Converter>
            </Binding>
        </Grid.Visibility>

        <!-- Full-screen fantasy landscape background -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Background>
                <ImageBrush ImageSource="{Binding backgroundImage}" Stretch="UniformToFill"/>
            </Border.Background>
        </Border>

        <!-- Semi-transparent dark overlay for readability -->
        <Border Background="#22000000"/>

        <!-- Layout -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.03*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.03*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0"/>
            </Grid.RowDefinitions>

            <!-- Header bar: REWARD | SKULLS | SKILL TREE (3 equal buttons) -->
            <Grid Grid.Row="1" VerticalAlignment="Top" Height="280">
                <!-- Dark wood gradient background matching GameHud style -->
                <Border CornerRadius="0,0,40,40">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#F02a1a0e" Offset="0"/>
                            <GradientStop Color="#FF0a0500" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <!-- Gold bottom border line -->
                    <Border BorderThickness="0,0,0,6" BorderBrush="#553B14" CornerRadius="0,0,40,40"/>
                </Border>

                <!-- Content: Three equal sections -->
                <Grid Margin="60,36,60,36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: REWARD button (opens Achievements) -->
                    <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                        <Grid.RenderTransform><ScaleTransform x:Name="AchievementScaleTransform" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Grid.Resources>
                            <Storyboard x:Key="AchievementPulseAnim" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="AchievementScaleTransform" Storyboard.TargetProperty="ScaleX" From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="AchievementScaleTransform" Storyboard.TargetProperty="ScaleY" From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
