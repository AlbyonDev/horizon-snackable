                            <Ellipse Width="10" Height="10" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28,8,28,8">
                                <TextBlock Text="{Binding runLabel}" FontFamily="Anton" FontSize="64" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="-3,0,0,0"/>
