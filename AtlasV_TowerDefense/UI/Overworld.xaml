                <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,24"/>
                <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="27,0,0,27"/>
                <Ellipse Width="18" Height="18" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"/>
                <Ellipse Width="12" Height="12" Fill="#FFc9a000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,27,27"/>

                <!-- Centered Next Level text with crossed swords icon -->
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="60,0,60,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Relics button: ANIMATED version (visible when relicPulseActive=True) -->
                    <!-- Uses the same b:EventTrigger auto-play pattern as Trophies/Skulls -->
                    <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding relicPulseActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RenderTransform><ScaleTransform x:Name="RelicScaleTransform" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Grid.Resources>
                            <Storyboard x:Key="RelicPulseAnim" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="RelicScaleTransform"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="RelicScaleTransform"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="RelicGlowBorder"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
