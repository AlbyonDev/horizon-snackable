                            <b:EventTrigger EventName="MouseLeftButtonDown"><b:ControlStoryboardAction Storyboard="{StaticResource SkillTreePressAnim}"/></b:EventTrigger>
                        </b:Interaction.Triggers>
                        <Border x:Name="SkillTreeGlowBorder" Opacity="0" Background="Transparent" BorderBrush="#AAf5c518" BorderThickness="10" CornerRadius="24" Margin="-8,-8,-8,-8"/>
                        <Border Background="#CC1a1a2e" BorderBrush="{StaticResource GoldBrush}" BorderThickness="5" CornerRadius="18">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="MouseLeftButtonUp">
