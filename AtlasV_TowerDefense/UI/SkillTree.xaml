<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <!-- Palette -->
        <SolidColorBrush x:Key="CreamPathBrush" Color="#FFF5E6D0"/>
        <SolidColorBrush x:Key="CreamPathDimBrush" Color="#66F5E6D0"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#FFf5c518"/>
        <SolidColorBrush x:Key="DarkFillBrush" Color="#FF1A1420"/>
        <SolidColorBrush x:Key="NodeLockedBorderBrush" Color="#44F5E6D0"/>
        <SolidColorBrush x:Key="NodeBuyableBorderBrush" Color="#CCF5E6D0"/>
        <SolidColorBrush x:Key="NodeBoughtBorderBrush" Color="#FFf5c518"/>
        <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="WhiteGlowBrush" Color="#FFFFFFFF"/>
    </Page.Resources>

    <Grid Visibility="{Binding visible, Converter={StaticResource BoolToVisConverter}}">

        <!-- Hazy gradient background: dark muted purple top → warm reddish-brown bottom -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FF2A1B3D" Offset="0"/>
                    <GradientStop Color="#FF3D2235" Offset="0.4"/>
                    <GradientStop Color="#FF4A2C2A" Offset="0.8"/>
                    <GradientStop Color="#FF3D2218" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Subtle haze overlay for depth -->
        <Rectangle Opacity="0.15">
            <Rectangle.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FF8866AA" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Viewbox Stretch="Uniform" Margin="20,20,20,20">
        <Grid Width="1080" Height="1920">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ TITLE + SKULL BALANCE ═══ -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,30,0,10">
                <Grid HorizontalAlignment="Center">
                    <TextBlock Text="SKILL TREE" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="#22000000" Margin="-3,0,0,0"/>
                    <TextBlock Text="SKILL TREE" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="#22000000" Margin="3,0,0,0"/>
                    <TextBlock Text="SKILL TREE" FontFamily="Anton" FontSize="88" FontWeight="Bold" Foreground="#FFF5E6D0"/>
                </Grid>
                <!-- Skull balance -->
                <Border Background="#33000000" BorderBrush="{StaticResource CreamPathBrush}" BorderThickness="2" CornerRadius="24" Padding="30,10,30,10" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Viewbox Width="52" Height="52" Margin="0,0,12,0">
                            <Grid Width="24" Height="24">
                                <Path Fill="#E8E8E8" Data="M12 2 C7 2 3 6 3 11 C3 14 4 16 6 17 L6 20 C6 21 7 22 8 22 L16 22 C17 22 18 21 18 20 L18 17 C20 16 21 14 21 11 C21 6 17 2 12 2 Z"/>
                                <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,2"/>
                                <Path Fill="#1A1A2E" Data="M11 14 L12 16 L13 14 Z"/><Path Fill="#1A1A2E" Data="M9 18 L9 20 M11 18 L11 20 M13 18 L13 20 M15 18 L15 20" StrokeThickness="0.8" Stroke="#1A1A2E"/>
                            </Grid>
                        </Viewbox>
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="{Binding skullCount, StringFormat=F0}" FontFamily="Anton" FontSize="56" FontWeight="Bold" Foreground="#22000000" Margin="-2,0,0,0"/>
                            <TextBlock Text="{Binding skullCount, StringFormat=F0}" FontFamily="Anton" FontSize="56" FontWeight="Bold" Foreground="#FFF5E6D0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ ORGANIC TREE CANVAS (scrollable) ═══ -->
