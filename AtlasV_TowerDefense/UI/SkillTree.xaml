                    <Button Canvas.Left="{Binding node16X}" Canvas.Top="{Binding node16Y}" Command="{Binding Path=events.skillTap}" CommandParameter="16" Background="{StaticResource TransparentBrush}" BorderThickness="0" ClipToBounds="False"><Grid Width="270" ClipToBounds="False"><StackPanel HorizontalAlignment="Center" ClipToBounds="False"><Grid Width="210" Height="210" Margin="-10,-10,-10,-10" HorizontalAlignment="Center" ClipToBounds="False" RenderTransformOrigin="0.5,0.5" Tag="{Binding node16PulseVisible}" Style="{StaticResource BuyableNodeBreathing}"><Ellipse Width="190" Height="190" Fill="#221A1420"/><Ellipse Width="200" Height="200" Stroke="#AAf5c518" StrokeThickness="8" Fill="Transparent" Style="{StaticResource BuyableNodeGlow}" Visibility="{Binding node16PulseVisible, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="190" Height="190" Stroke="#C0392B" StrokeThickness="8" Fill="#FF2E0E0E" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="170" Height="170" Stroke="{Binding node16BorderColor}" StrokeThickness="4" Fill="#FF2E0E0E" HorizontalAlignment="Center" VerticalAlignment="Center"/><Viewbox Width="130" Height="130" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid Width="130" Height="130"><Image Source="Textures/fire_tower.png" Stretch="Uniform" Opacity="{Binding node16IconOpacity}"/></Grid></Viewbox></Grid><Border Background="#CC1A1420" CornerRadius="8" Padding="11,6,11,6" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="{Binding node16CostVisible, Converter={StaticResource BoolToVisConverter}}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Viewbox Width="36" Height="36" Margin="0,0,6,0"><Grid Width="24" Height="24"><Path Fill="#E8E8E8" Data="M12 2 C7 2 3 6 3 11 C3 14 4 16 6 17 L6 20 C6 21 7 22 8 22 L16 22 C17 22 18 21 18 20 L18 17 C20 16 21 14 21 11 C21 6 17 2 12 2 Z"/><Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,2"/><Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,2"/><Path Fill="#1A1A2E" Data="M11 14 L12 16 L13 14 Z"/><Path Fill="#1A1A2E" Data="M9 18 L9 20 M11 18 L11 20 M13 18 L13 20 M15 18 L15 20" StrokeThickness="0.8" Stroke="#1A1A2E"/></Grid></Viewbox><TextBlock Text="{Binding node16Cost}" FontFamily="Anton" FontSize="43" Foreground="{Binding node16CostColor}" HorizontalAlignment="Center" TextAlignment="Center"/></StackPanel></Border></StackPanel></Grid></Button>
                    <!-- Node 17: Fortify T6 -->
                    <Button Canvas.Left="{Binding node17X}" Canvas.Top="{Binding node17Y}" Command="{Binding Path=events.skillTap}" CommandParameter="17" Background="{StaticResource TransparentBrush}" BorderThickness="0" ClipToBounds="False"><Grid Width="270" ClipToBounds="False"><StackPanel HorizontalAlignment="Center" ClipToBounds="False"><Grid Width="180" Height="180" Margin="-10,-10,-10,-10" HorizontalAlignment="Center" ClipToBounds="False" RenderTransformOrigin="0.5,0.5" Tag="{Binding node17PulseVisible}" Style="{StaticResource BuyableNodeBreathing}"><Ellipse Width="170" Height="170" Stroke="#AAf5c518" StrokeThickness="8" Fill="Transparent" Style="{StaticResource BuyableNodeGlow}" Visibility="{Binding node17PulseVisible, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="150" Height="150" Stroke="{Binding node17BorderColor}" StrokeThickness="4" Fill="{StaticResource DarkFillBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Viewbox Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid Width="110" Height="110"><Image Source="sprites/skilltree/icon_lightning.png" Stretch="Uniform" Opacity="{Binding node17IconOpacity}"/></Grid></Viewbox></Grid><Border Background="#CC1A1420" CornerRadius="8" Padding="11,6,11,6" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="{Binding node17CostVisible, Converter={StaticResource BoolToVisConverter}}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Viewbox Width="36" Height="36" Margin="0,0,6,0"><Grid Width="24" Height="24"><Path Fill="#E8E8E8" Data="M12 2 C7 2 3 6 3 11 C3 14 4 16 6 17 L6 20 C6 21 7 22 8 22 L16 22 C17 22 18 21 18 20 L18 17 C20 16 21 14 21 11 C21 6 17 2 12 2 Z"/><Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,2"/><Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,2"/><Path Fill="#1A1A2E" Data="M11 14 L12 16 L13 14 Z"/><Path Fill="#1A1A2E" Data="M9 18 L9 20 M11 18 L11 20 M13 18 L13 20 M15 18 L15 20" StrokeThickness="0.8" Stroke="#1A1A2E"/></Grid></Viewbox><TextBlock Text="{Binding node17Cost}" FontFamily="Anton" FontSize="43" Foreground="{Binding node17CostColor}" HorizontalAlignment="Center" TextAlignment="Center"/></StackPanel></Border></StackPanel></Grid></Button>
                    <!-- Node 18: Fortune T6 — Tower Unlock (crimson style, matches node 8, 10, 16, 19) -->
                    <Button Canvas.Left="{Binding node18X}" Canvas.Top="{Binding node18Y}" Command="{Binding Path=events.skillTap}" CommandParameter="18" Background="{StaticResource TransparentBrush}" BorderThickness="0" ClipToBounds="False"><Grid Width="270" ClipToBounds="False"><StackPanel HorizontalAlignment="Center" ClipToBounds="False"><Grid Width="210" Height="210" Margin="-10,-10,-10,-10" HorizontalAlignment="Center" ClipToBounds="False" RenderTransformOrigin="0.5,0.5" Tag="{Binding node18PulseVisible}" Style="{StaticResource BuyableNodeBreathing}"><Ellipse Width="190" Height="190" Fill="#221A1420"/><Ellipse Width="200" Height="200" Stroke="#AAf5c518" StrokeThickness="8" Fill="Transparent" Style="{StaticResource BuyableNodeGlow}" Visibility="{Binding node18PulseVisible, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="190" Height="190" Stroke="#C0392B" StrokeThickness="8" Fill="#FF2E0E0E" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="170" Height="170" Stroke="{Binding node18BorderColor}" StrokeThickness="4" Fill="#FF2E0E0E" HorizontalAlignment="Center" VerticalAlignment="Center"/><Viewbox Width="130" Height="130" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid Width="130" Height="130"><Image Source="Textures/lightning_tower.png" Stretch="Uniform" Opacity="{Binding node18IconOpacity}"/></Grid></Viewbox></Grid><Border Background="#CC1A1420" CornerRadius="8" Padding="11,6,11,6" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="{Binding node18CostVisible, Converter={StaticResource BoolToVisConverter}}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Viewbox Width="36" Height="36" Margin="0,0,6,0"><Grid Width="24" Height="24"><Path Fill="#E8E8E8" Data="M12 2 C7 2 3 6 3 11 C3 14 4 16 6 17 L6 20 C6 21 7 22 8 22 L16 22 C17 22 18 21 18 20 L18 17 C20 16 21 14 21 11 C21 6 17 2 12 2 Z"/><Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,2"/><Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,2"/><Path Fill="#1A1A2E" Data="M11 14 L12 16 L13 14 Z"/><Path Fill="#1A1A2E" Data="M9 18 L9 20 M11 18 L11 20 M13 18 L13 20 M15 18 L15 20" StrokeThickness="0.8" Stroke="#1A1A2E"/></Grid></Viewbox><TextBlock Text="{Binding node18Cost}" FontFamily="Anton" FontSize="43" Foreground="{Binding node18CostColor}" HorizontalAlignment="Center" TextAlignment="Center"/></StackPanel></Border></StackPanel></Grid></Button>

                    <!-- Node 9: Fortune T3 -->
                    <Button Canvas.Left="{Binding node9X}" Canvas.Top="{Binding node9Y}"
                            Command="{Binding Path=events.skillTap}" CommandParameter="9"
                            Background="{StaticResource TransparentBrush}" BorderThickness="0" ClipToBounds="False">
                        <Grid Width="270" HorizontalAlignment="Center" ClipToBounds="False">
                            <StackPanel HorizontalAlignment="Center" ClipToBounds="False">
                                <Grid Width="180" Height="180" Margin="-10,-10,-10,-10" HorizontalAlignment="Center" ClipToBounds="False" RenderTransformOrigin="0.5,0.5" Tag="{Binding node9PulseVisible}" Style="{StaticResource BuyableNodeBreathing}">
                                    <Ellipse Width="160" Height="160" Fill="#221A1420"/>
                                    <Ellipse Width="170" Height="170" Stroke="#AAf5c518" StrokeThickness="8" Fill="Transparent" Style="{StaticResource BuyableNodeGlow}" Visibility="{Binding node9PulseVisible, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="150" Height="150" Stroke="{Binding node9BorderColor}" StrokeThickness="4" Fill="{StaticResource DarkFillBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Viewbox Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="110" Height="110">
                                            <Image Source="sprites/skilltree/icon_refund.png" Stretch="Uniform" Opacity="{Binding node9IconOpacity}"/>
                                        </Grid>
                                    </Viewbox>

                                </Grid>
                                <Border Background="#CC1A1420" CornerRadius="8" Padding="11,6,11,6" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="{Binding node9CostVisible, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Viewbox Width="36" Height="36" Margin="0,0,6,0"><Grid Width="24" Height="24"><Path Fill="#E8E8E8" Data="M12 2 C7 2 3 6 3 11 C3 14 4 16 6 17 L6 20 C6 21 7 22 8 22 L16 22 C17 22 18 21 18 20 L18 17 C20 16 21 14 21 11 C21 6 17 2 12 2 Z"/><Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,2"/><Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,2"/><Path Fill="#1A1A2E" Data="M11 14 L12 16 L13 14 Z"/><Path Fill="#1A1A2E" Data="M9 18 L9 20 M11 18 L11 20 M13 18 L13 20 M15 18 L15 20" StrokeThickness="0.8" Stroke="#1A1A2E"/></Grid></Viewbox><TextBlock Text="{Binding node9Cost}" FontFamily="Anton" FontSize="43" Foreground="{Binding node9CostColor}" HorizontalAlignment="Center" TextAlignment="Center"/></StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Button>

                </Canvas>
            </ScrollViewer>

            <!-- ═══ CLOSE BUTTON ═══ -->
            <Button Grid.Row="2" Command="{Binding Path=events.closeTap}" CommandParameter="close"
                    Background="{StaticResource TransparentBrush}" BorderThickness="0"
                    HorizontalAlignment="Center" Margin="0,10,0,20">
                <Border Background="#CC1A1420" BorderBrush="{StaticResource CreamPathBrush}" BorderThickness="3" CornerRadius="30" Padding="60,16,60,16">
                    <TextBlock Text="CLOSE" FontFamily="Anton" FontSize="52" FontWeight="Bold" Foreground="#FFF5E6D0" HorizontalAlignment="Center"/>
                </Border>
            </Button>
        </Grid>
        </Viewbox>

        <!-- ═══ POPUP OVERLAY ═══ -->
        <Grid Visibility="{Binding popupVisible, Converter={StaticResource BoolToVisConverter}}">
            <!-- Semi-transparent dark backdrop -->
            <Border Background="#CC000000"/>

            <!-- Centered popup panel -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F01A1420" BorderBrush="{StaticResource GoldBrush}" BorderThickness="8"
                    CornerRadius="40" Padding="100,70,100,70" Width="1600">
                <StackPanel HorizontalAlignment="Center" ClipToBounds="False">
                    <!-- Node description -->
                    <TextBlock Text="{Binding popupDescription}" FontFamily="Anton" FontSize="110" FontWeight="Bold"
                               Foreground="#FFF5E6D0" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <!-- Node detail text (description from defs) -->
                    <TextBlock Text="{Binding popupDetailText}" FontFamily="Anton" FontSize="66" FontWeight="Normal"
                               Foreground="#AAF5E6D0" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,44"/>

                    <!-- Cost row (hidden if already bought) -->
                    <Border Background="#33000000" CornerRadius="28" Padding="40,20,40,20"
                            HorizontalAlignment="Center" Margin="0,0,0,56"
                            Visibility="{Binding popupCostVisible, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="76" Height="76" Margin="0,0,16,0">
                                <Grid Width="24" Height="24">
                                    <Path Fill="#E8E8E8" Data="M12 2 C7 2 3 6 3 11 C3 14 4 16 6 17 L6 20 C6 21 7 22 8 22 L16 22 C17 22 18 21 18 20 L18 17 C20 16 21 14 21 11 C21 6 17 2 12 2 Z"/>
                                    <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                    <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,2"/>
                                    <Path Fill="#1A1A2E" Data="M11 14 L12 16 L13 14 Z"/><Path Fill="#1A1A2E" Data="M9 18 L9 20 M11 18 L11 20 M13 18 L13 20 M15 18 L15 20" StrokeThickness="0.8" Stroke="#1A1A2E"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{Binding popupCost}" FontFamily="Anton" FontSize="88" FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- RETURN button -->
                        <Button Command="{Binding Path=events.returnTap}" CommandParameter="return"
                                Background="{StaticResource TransparentBrush}" BorderThickness="0" Margin="0,0,40,0">
                            <Border Background="#CC1A1420" BorderBrush="{StaticResource CreamPathBrush}" BorderThickness="7"
                                    CornerRadius="30" Padding="70,28,70,28">
                                <TextBlock Text="RETURN" FontFamily="Anton" FontSize="82" FontWeight="Bold"
                                           Foreground="#FFF5E6D0" HorizontalAlignment="Center"/>
                            </Border>
                        </Button>

                        <!-- BUY button (hidden if already bought or cannot buy) -->
                        <Button Command="{Binding Path=events.buyTap}" CommandParameter="buy"
                                Background="{StaticResource TransparentBrush}" BorderThickness="0"
                                Visibility="{Binding popupBuyVisible, Converter={StaticResource BoolToVisConverter}}">
                            <Border Background="#CC1A1420" BorderBrush="{StaticResource GoldBrush}" BorderThickness="7"
                                    CornerRadius="30" Padding="70,28,70,28">
                                <TextBlock Text="BUY" FontFamily="Anton" FontSize="82" FontWeight="Bold"
                                           Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                            </Border>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
