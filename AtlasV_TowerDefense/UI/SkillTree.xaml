                            <Grid.Resources>
                                <Storyboard x:Key="SkBuyPulseAnim" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SkBuyScale" Storyboard.TargetProperty="ScaleX"
                                                     From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="SkBuyScale" Storyboard.TargetProperty="ScaleY"
                                                     From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="SkBuyGlow" Storyboard.TargetProperty="Opacity"
                                                     From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                                <Storyboard x:Key="SkBuyPressAnim">
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SkBuyScale" Storyboard.TargetProperty="ScaleX">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.90"><EasingDoubleKeyFrame.EasingFunction><PowerEase EasingMode="EaseOut" Power="2"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0"><EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SkBuyScale" Storyboard.TargetProperty="ScaleY">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.90"><EasingDoubleKeyFrame.EasingFunction><PowerEase EasingMode="EaseOut" Power="2"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0"><EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </Grid.Resources>
                            <b:Interaction.Triggers>
                                <b:EventTrigger>
                                    <b:ControlStoryboardAction Storyboard="{StaticResource SkBuyPulseAnim}"/>
                                </b:EventTrigger>
                                <b:EventTrigger EventName="MouseLeftButtonDown">
                                    <b:ControlStoryboardAction Storyboard="{StaticResource SkBuyPressAnim}"/>
                                </b:EventTrigger>
                            </b:Interaction.Triggers>

                            <Border x:Name="SkBuyGlow" Opacity="0" Background="Transparent"
                                    BorderBrush="#AAf5c518" BorderThickness="10" CornerRadius="38"
                                    Margin="-8,-8,-8,-8" IsHitTestVisible="False"/>

                            <Button Command="{Binding Path=events.buyTap}" CommandParameter="buy"
                                    Background="{StaticResource TransparentBrush}" BorderThickness="0">
                                <Border Background="#CC1A1420" BorderBrush="{StaticResource GoldBrush}" BorderThickness="7"
                                        CornerRadius="30" Padding="70,28,70,28">
                                    <TextBlock Text="BUY" FontFamily="Anton" FontSize="82" FontWeight="Bold"
                                               Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- ═══ TOWER UNLOCK POPUP (two-column layout) ═══ -->
                <Grid Visibility="{Binding popupIsTowerUnlock, Converter={StaticResource BoolToVisConverter}}"
                      HorizontalAlignment="Center" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Tower card image -->
                    <Border Grid.Column="0" Width="380" Height="380" CornerRadius="24"
                            Margin="0,0,60,0" VerticalAlignment="Center">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding popupTowerImage}" Stretch="Uniform"/>
                        </Border.Background>
                    </Border>

                    <!-- RIGHT: Name, description, cost, buttons -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Tower name -->
                        <TextBlock Text="{Binding popupDescription}" FontFamily="Anton" FontSize="96" FontWeight="Bold"
                                   Foreground="#FFF5E6D0" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Tower description -->
                        <TextBlock Text="{Binding popupDetailText}" FontFamily="Anton" FontSize="58" FontWeight="Normal"
                                   Foreground="#AAF5E6D0" TextWrapping="Wrap" Margin="0,0,0,24"/>

                        <!-- Cost row -->
                        <Border Background="#33000000" CornerRadius="28" Padding="36,16,36,16"
                                HorizontalAlignment="Left" Margin="0,0,0,40"
                                Visibility="{Binding popupCostVisible, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="68" Height="68" Margin="0,0,14,0">
                                    <Grid Width="24" Height="24">
                                        <Path Fill="#E8E8E8" Data="M12 2 C7 2 3 6 3 11 C3 14 4 16 6 17 L6 20 C6 21 7 22 8 22 L16 22 C17 22 18 21 18 20 L18 17 C20 16 21 14 21 11 C21 6 17 2 12 2 Z"/>
                                        <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                        <Ellipse Width="4" Height="5" Fill="#1A1A2E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,2"/>
                                        <Path Fill="#1A1A2E" Data="M11 14 L12 16 L13 14 Z"/><Path Fill="#1A1A2E" Data="M9 18 L9 20 M11 18 L11 20 M13 18 L13 20 M15 18 L15 20" StrokeThickness="0.8" Stroke="#1A1A2E"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="{Binding popupCost}" FontFamily="Anton" FontSize="78" FontWeight="Bold"
                                           Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Buttons row -->
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding Path=events.returnTap}" CommandParameter="return"
                                    Background="{StaticResource TransparentBrush}" BorderThickness="0" Margin="0,0,30,0">
                                <Border Background="#CC1A1420" BorderBrush="{StaticResource CreamPathBrush}" BorderThickness="6"
                                        CornerRadius="26" Padding="56,22,56,22">
                                    <TextBlock Text="RETURN" FontFamily="Anton" FontSize="70" FontWeight="Bold"
                                               Foreground="#FFF5E6D0" HorizontalAlignment="Center"/>
                                </Border>
                            </Button>
                            <Button Command="{Binding Path=events.buyTap}" CommandParameter="buy"
                                    Background="{StaticResource TransparentBrush}" BorderThickness="0"
                                    Visibility="{Binding popupBuyVisible, Converter={StaticResource BoolToVisConverter}}">
                                <Border Background="#CC1A1420" BorderBrush="{StaticResource GoldBrush}" BorderThickness="6"
                                        CornerRadius="26" Padding="56,22,56,22">
                                    <TextBlock Text="BUY" FontFamily="Anton" FontSize="70" FontWeight="Bold"
                                               Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                </Grid>

            </Border>
        </Grid>
    </Grid>
</Page>
