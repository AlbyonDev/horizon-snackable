<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d">

    <Page.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1a1a2e"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#f5c518"/>
        <SolidColorBrush x:Key="GoldDarkBrush" Color="#c9a000"/>
        <SolidColorBrush x:Key="GoldLightBrush" Color="#ffd84a"/>
        <SolidColorBrush x:Key="TextWhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextGoldBrush" Color="#d4a84a"/>
        <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    </Page.Resources>

    <!-- Main Container - Full Screen Overlay -->
    <Grid>
        <Grid.Visibility>
            <Binding Path="visible">
                <Binding.Converter>
                    <BooleanToVisibilityConverter/>
                </Binding.Converter>
            </Binding>
        </Grid.Visibility>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#FF000000" Offset="0"/>
                <GradientStop Offset="1" Color="#FF1A1A2E"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Content Layout -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <!-- Row 0: Top spacing -->
                <RowDefinition Height="0.15*"/>
                <!-- Row 1: Logo area -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Flexible space -->
                <RowDefinition Height="0.1*"/>
                <!-- Row 3: Button area -->
                <RowDefinition Height="Auto"/>
                <!-- Row 4: Subtitle text -->
                <RowDefinition Height="Auto"/>
                <!-- Row 5: Bottom spacing -->
                <RowDefinition Height="0.2*"/>
            </Grid.RowDefinitions>

            <!-- Row 1: Logo Image - Large and Prominent -->
            <Image Grid.Row="1"
                   Source="/Root;component/Textures/GoblinClash_logo.png" Stretch="UniformToFill"/>

            <!-- Row 3: JOUER Button with 3D Medieval Style -->
            <Grid Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                <Grid.RenderTransform><ScaleTransform x:Name="PlayBtnScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                <Grid.Resources>
                    <Storyboard x:Key="PlayBtnPulseAnim" RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="PlayBtnScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="PlayBtnScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="1.0" To="1.06" Duration="0:0:0.9" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="PlayBtnGlow"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.0" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                    <Storyboard x:Key="PlayBtnPressAnim">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayBtnScale" Storyboard.TargetProperty="ScaleX">
                            <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.90">
                                <EasingDoubleKeyFrame.EasingFunction><PowerEase EasingMode="EaseOut" Power="2"/></EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0">
                                <EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/></EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayBtnScale" Storyboard.TargetProperty="ScaleY">
                            <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="0.90">
                                <EasingDoubleKeyFrame.EasingFunction><PowerEase EasingMode="EaseOut" Power="2"/></EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0">
                                <EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/></EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </Grid.Resources>
                <b:Interaction.Triggers>
                    <b:EventTrigger>
                        <b:ControlStoryboardAction Storyboard="{StaticResource PlayBtnPulseAnim}"/>
                    </b:EventTrigger>
                    <b:EventTrigger EventName="MouseLeftButtonDown">
                        <b:ControlStoryboardAction Storyboard="{StaticResource PlayBtnPressAnim}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>

                <!-- Outer glow border (pulsing golden shimmer) -->
                <Border x:Name="PlayBtnGlow" Opacity="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="992" Height="312"
                        Background="Transparent"
                        BorderBrush="#AAf5c518"
                        BorderThickness="10"
                        CornerRadius="38"
                        IsHitTestVisible="False"/>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Loading/ready state: overlay + label text driven by isLoading/buttonLabel.
                     Tap is also ignored in TitleScreenHud.onPlayTap until the cloud save loads. -->
                <b:Interaction.Triggers>
                    <b:DataTrigger Binding="{Binding isLoading}" Value="True">
                        <b:ChangePropertyAction TargetName="PlayButtonDisabled" PropertyName="Visibility" Value="Visible"/>
                    </b:DataTrigger>
                    <b:DataTrigger Binding="{Binding isLoading}" Value="False">
                        <b:ChangePropertyAction TargetName="PlayButtonDisabled" PropertyName="Visibility" Value="Collapsed"/>
                    </b:DataTrigger>
                </b:Interaction.Triggers>
                <!-- Shadow layer for 3D depth effect - offset behind -->
                <Border Margin="16,16,0,0"
                        CornerRadius="32"
                        Width="960"
                        Height="280" Background="#FF000000"/>

                <!-- Main button container -->
                <Button Command="{Binding Path=events.playTap}"
                        Background="{StaticResource TransparentBrush}"
                        BorderThickness="0"
                        Width="960"
                        Height="280"
                        Cursor="Hand" Padding="0,0,0,0">
                    <!-- Outer ornate frame -->
                    <Border CornerRadius="32"
                            BorderThickness="12"
                            Width="960" Height="280" BorderBrush="#FFFDBA12">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF070701" Offset="0"/>
                                <GradientStop Color="#FF1D1D1C" Offset="0"/>
                                <GradientStop Offset="0" Color="#FF000000"/>
                                <GradientStop Offset="1" Color="#FF3D2407"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontSize="144" FontWeight="Bold" Foreground="Black" Margin="-6,0,0,0" Text="{Binding buttonLabel}" FontFamily="Anton"/>
                            <TextBlock FontSize="144" FontWeight="Bold" Foreground="Black" Margin="6,0,0,0" Text="{Binding buttonLabel}" FontFamily="Anton"/>
                            <TextBlock FontSize="144" FontWeight="Bold" Foreground="Black" Margin="0,-6,0,0" Text="{Binding buttonLabel}" FontFamily="Anton"/>
                            <TextBlock FontSize="144" FontWeight="Bold" Foreground="Black" Margin="0,6,0,0" Text="{Binding buttonLabel}" FontFamily="Anton"/>
                            <TextBlock FontSize="144" FontWeight="Bold" Text="{Binding buttonLabel}" FontFamily="Anton" Foreground="#FFF5E6C8"/>
                        </Grid>
                    </Border>
                </Button>
                <Grid Margin="20,20,20,20">
                    <Ellipse Width="36" Height="36" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0"/>
                    <Ellipse Width="20" Height="20" Fill="{StaticResource GoldDarkBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,24,0,0"/>
                    <Ellipse Width="36" Height="36" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"/>
                    <Ellipse Width="20" Height="20" Fill="{StaticResource GoldDarkBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"/>
                    <Ellipse Width="36" Height="36" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,16"/>
                    <Ellipse Width="20" Height="20" Fill="{StaticResource GoldDarkBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,24"/>
                    <Ellipse Width="36" Height="36" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"/>
                    <Ellipse Width="20" Height="20" Fill="{StaticResource GoldDarkBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"/>
                </Grid>

                <!-- Disabled overlay: darkens the button while waiting for the cloud save.
                     Visible by default (matches ViewModel.isLoading=true); toggled by triggers above. -->
                <Border x:Name="PlayButtonDisabled"
                        CornerRadius="32"
                        Width="960"
                        Height="280"
                        Background="#AF000000"
                        IsEnabled="False"
                        Visibility="Visible"/>
            </Grid>
            </Grid>

            <!-- Row 4: Reset save data button / "data reset" label -->
            <Grid Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                <!-- Reset Button (hidden after reset) -->
                <Button Command="{Binding Path=events.resetTap}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0" Cursor="Hand">
                    <Button.Visibility>
                        <Binding Path="resetButtonVisible">
                            <Binding.Converter>
                                <BooleanToVisibilityConverter/>
                            </Binding.Converter>
                        </Binding>
                    </Button.Visibility>
                    <Border CornerRadius="16" BorderThickness="4" BorderBrush="#88f5c518"
                            Padding="40,16,40,16" Background="#44000000">
                        <TextBlock Text="Reset save data" FontSize="48" FontFamily="Anton"
                                   Foreground="#AAf5c518" HorizontalAlignment="Center"/>
                    </Border>
                </Button>
                <!-- "data reset" label (shown after reset) -->
                <TextBlock Text="data reset" FontSize="48" FontFamily="Anton"
                           Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Visibility>
                        <Binding Path="resetDoneVisible">
                            <Binding.Converter>
                                <BooleanToVisibilityConverter/>
                            </Binding.Converter>
                        </Binding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Confirmation Popup Overlay -->
        <Grid>
            <Grid.Visibility>
                <Binding Path="resetPopupVisible">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter/>
                    </Binding.Converter>
                </Binding>
            </Grid.Visibility>
            <!-- Semi-transparent dim background -->
            <Rectangle Fill="#CC000000"/>
            <!-- Popup dialog -->
            <Border Background="#FF1a1a2e" CornerRadius="24" BorderThickness="6"
                    BorderBrush="#FFf5c518" Padding="60,40,60,40"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="800">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Reset Save Data?" FontSize="72" FontWeight="Bold"
                               FontFamily="Anton" Foreground="#FFF5E6C8"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="All progress will be lost." FontSize="44"
                               FontFamily="Anton" Foreground="#AAFFFFFF"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- YES button -->
                        <Button Command="{Binding Path=events.resetConfirm}"
                                Background="Transparent" BorderThickness="0"
                                Padding="0" Cursor="Hand" Margin="0,0,30,0">
                            <Border CornerRadius="16" BorderThickness="4" BorderBrush="#FFFF4444"
                                    Padding="50,20,50,20" Background="#44FF0000">
                                <TextBlock Text="YES" FontSize="56" FontFamily="Anton"
                                           Foreground="#FFFF6666" HorizontalAlignment="Center"/>
                            </Border>
                        </Button>
                        <!-- NO button -->
                        <Button Command="{Binding Path=events.resetCancel}"
                                Background="Transparent" BorderThickness="0"
                                Padding="0" Cursor="Hand" Margin="30,0,0,0">
                            <Border CornerRadius="16" BorderThickness="4" BorderBrush="#88f5c518"
                                    Padding="50,20,50,20" Background="#44000000">
                                <TextBlock Text="NO" FontSize="56" FontFamily="Anton"
                                           Foreground="#FFF5E6C8" HorizontalAlignment="Center"/>
                            </Border>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
