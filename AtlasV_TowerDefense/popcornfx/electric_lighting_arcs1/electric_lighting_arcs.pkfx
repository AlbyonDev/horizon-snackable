CParticleNodeAnnotation	$6790FC74
{
	CustomName = {
		"@eng:ai_data",
	};
	Description = {
		"@eng:effect_description: Dynamic electrical arc and lightning bolt effect with animated crackling energy trails. Creates branching electric discharge patterns that jump between points with realistic flickering behavior. Features glowing core with outer corona and ribbon-based arc segments.\\n\\ntags: electric, lightning, arcs, electricity, energy, scifi, tech, power, spark, discharge, bolt, zap, shock, plasma, tesla, current, voltage, storm, weather, magic, spell, sci-fi, futuristic, cyberpunk, neon\\n\\ncategory: scifi\\n\\n---\\n\\nSuggested Presets:\\n\\n[Subtle Spark] (Confidence: 0.90)\\nSmall, quick electrical sparks for subtle accents\\nParams: global_scale=0.5, arc_lifetime_min_max=(0.05, 0.15), speed=8.0, color_intensity=8.0\\n\\n[Standard Arc] (Confidence: 0.95)\\nBalanced lightning arc for general use\\nParams: global_scale=2.0, arc_lifetime_min_max=(0.2, 0.4), speed=5.0, color_intensity=14.0\\n\\n[Tesla Coil] (Confidence: 0.88)\\nContinuous crackling electricity like a tesla coil\\nParams: global_scale=1.5, arc_spawn_min_max=(10, 20), speed=12.0, arc_size=0.015\\n\\n[Lightning Storm] (Confidence: 0.85)\\nLarge dramatic lightning bolts\\nParams: global_scale=5.0, arc_lifetime_min_max=(0.3, 0.6), color_intensity=30.0, arc_size=0.08\\n\\n[Cyberpunk Neon] (Confidence: 0.82)\\nStylized pink/purple electric effect\\nParams: electricity_color_hsv=(0.85, 0.9, 1.0), color_intensity=20.0, speed=3.0\\n\\n---\\n\\nAlternate Use Cases:\\n\\n[Magic Lightning Spell]\\nAdjust: electricity_color_hsv=(0.75, 1.0, 1.0), global_scale=3.0\\nWhy: Purple-tinted lightning works for fantasy magic effects\\n\\n[Power Surge]\\nAdjust: arc_spawn_min_max=(20, 40), speed=15.0, color_intensity=35.0\\nWhy: Dense rapid arcs simulate electrical overload\\n\\n[Force Field Crackle]\\nAdjust: global_scale=0.3, arc_spawn_min_max=(5, 10), arc_lifetime_min_max=(0.1, 0.2)\\nWhy: Small quick arcs on surface suggest energy shield\\n\\n[Welding Sparks]\\nAdjust: global_scale=0.2, color_intensity=40.0, electricity_color_hsv=(0.1, 0.8, 1.0)\\nWhy: Bright orange-white sparks for industrial welding effect",
	};
	WorkspacePosition = int2(-3036, -132);
	PostItType = Blue;
	PostIt = true;
	SelfSize = int2(560, 436);
}
